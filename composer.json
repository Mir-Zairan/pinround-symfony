{
    "name": "pinround/pinround",
    "type": "project",
    "license": "proprietary",
    "description": "pinround",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-mbstring": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "ext-sodium": "*",
        "ext-xmlwriter": "*",
        "bacon/bacon-qr-code": "^3.1",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "doctrine/persistence": "^4.2",
        "monolog/monolog": "^3.12",
        "nyholm/psr7": "^1.8",
        "open-telemetry/api": "^1.11",
        "open-telemetry/context": "^1.6",
        "open-telemetry/exporter-otlp": "^1.5",
        "open-telemetry/sdk": "^1.16",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "spomky-labs/otphp": "^11.5",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/cache": "8.1.*",
        "symfony/cache-contracts": "^3.8",
        "symfony/clock": "8.1.*",
        "symfony/config": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dependency-injection": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/event-dispatcher": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/http-client-contracts": "^3.8",
        "symfony/http-foundation": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/password-hasher": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/redis-messenger": "8.1.*",
        "symfony/routing": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/security-core": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/security-http": "8.1.*",
        "symfony/service-contracts": "^3.8",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/twig-bridge": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-twig-component": "^3.7",
        "symfony/yaml": "8.1.*",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-doctrine": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpstan/phpstan-symfony": "^2",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/dom-crawler": "8.1.*",
        "symfony/error-handler": "8.1.*",
        "symfony/filesystem": "8.1.*",
        "symfony/process": "8.1.*",
        "zenstruck/foundry": "^2.15"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test:functional": "phpunit --testsuite functional",
        "cs": "php-cs-fixer fix --dry-run --diff --show-progress=none",
        "cs:fix": "php-cs-fixer fix",
        "rector": "rector process --dry-run --no-progress-bar",
        "phpstan": [
            "@php bin/console cache:warmup --env=dev",
            "phpstan analyse --memory-limit=1G"
        ],
        "deptrac": "deptrac analyse --no-interaction --no-progress --no-cache --fail-on-uncovered --report-uncovered",
        "lint:docs": "@php bin/lint-docs",
        "lint:copy": "@php bin/lint-copy",
        "lint": [
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config --parse-tags",
            "@php bin/console lint:twig src",
            "@php bin/check-tenant-setting",
            "@lint:docs",
            "@lint:copy"
        ],
        "qa": [
            "@composer validate --strict",
            "@cs",
            "@rector",
            "@phpstan",
            "@deptrac",
            "@lint",
            "@composer audit",
            "@test"
        ],
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
