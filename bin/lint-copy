#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * CI lint for plain copy (CLAUDE.md, "UI copy is plain English"). Prints `file:line: "phrase" — say "instead"` for every
 * banned phrase in user-visible text and exits 1.
 *
 * Banned phrases:
 * - every phrase in the "Avoid" column of the table under `## Words we do not use` in docs/00-product/glossary.md, read
 *   at run time (a cell with commas is several phrases);
 * - STATUS_JARGON below. The word "status" alone is a product word and is never banned.
 * Matching is case-insensitive, on word boundaries, and a plural `s` also matches.
 *
 * What is copy:
 * - Twig: text between tags, the values of COPY_ATTRIBUTES, and string literals inside `{{ ... }}` and `{% ... %}`
 *   (except the first literal of a TEMPLATE_NAME_TAGS tag, which is a template name). Twig comments, tag names, every other
 *   attribute and the content of <script> and <style> are not copy.
 * - YAML translation files: the values (not the keys, not comments).
 * - XLIFF files: the text of <source> and <target>.
 *
 * Usage: bin/lint-copy [--glossary <file>] [path...]. Without paths it scans *.twig under src/ and templates/ and
 * translations/*.{yaml,yml,xlf}, except the folders in SKIPPED_FOLDERS and its own fixture folder. With paths it scans
 * those files, or every Twig, YAML and XLIFF file in those folders. Exits 1 on a hit, 2 when a given path does not
 * exist or the glossary table is missing or holds no words.
 */
const GLOSSARY_FILE = 'docs/00-product/glossary.md';
const GLOSSARY_HEADING = '## Words we do not use';
// test-results holds Playwright's run output and tests/e2e/.auth the git-ignored e2e logins and keys.
const SKIPPED_FOLDERS = ['.claude', '.git', 'vendor', 'var', 'node_modules', 'test-results', 'tests/e2e/.auth'];
const OWN_FIXTURE_FOLDER = 'tests/Fixtures/CopyLint';
const COPY_ATTRIBUTES = ['aria-label', 'aria-description', 'title', 'alt', 'placeholder', 'label'];
const TEMPLATE_NAME_TAGS = ['extends', 'include', 'embed', 'import', 'from', 'use', 'form_theme', 'component'];
const STATUS_JARGON = [
    'workflow status' => 'status',
    'status changed' => 'moved',
    'change status' => 'move',
    'transition' => 'action / move',
    'transitioned' => 'moved',
];
const COPY_EXTENSIONS = ['twig', 'yaml', 'yml', 'xlf'];

/**
 * @return array<string, string> banned phrase (lowercase) => the glossary's "Say instead" text; empty when the file or the table is missing
 */
function readGlossaryWords(string $glossary): array
{
    if (!is_file($glossary)) {
        return [];
    }

    $words = [];
    $inTable = false;
    foreach (explode("\n", (string) file_get_contents($glossary)) as $line) {
        $line = rtrim($line);
        if (!$inTable) {
            $inTable = GLOSSARY_HEADING === $line;
            continue;
        }
        if (str_starts_with($line, '#')) {
            break;
        }
        if (!str_starts_with($line, '|') || 1 === preg_match('/^[\s:|-]*$/', $line)) {
            continue;
        }
        $cells = array_map('trim', explode('|', trim($line, '|')));
        if (\count($cells) < 2 || 'Avoid' === $cells[0]) {
            continue;
        }
        foreach (explode(',', $cells[0]) as $phrase) {
            $phrase = mb_strtolower(trim($phrase));
            if ('' !== $phrase) {
                $words[$phrase] = $cells[1];
            }
        }
    }

    return $words;
}

/** Replaces every character but newlines, so offsets and line numbers stay the same. */
function blankOut(string $text): string
{
    return (string) preg_replace('/[^\n]/', ' ', $text);
}

function lineAt(string $text, int $offset): int
{
    return 1 + substr_count($text, "\n", 0, $offset);
}

/**
 * @return list<array{int, string}> line of the first character, user-visible text
 */
function twigCopy(string $content): array
{
    $content = (string) preg_replace_callback('/\{#.*?#\}/s', static fn (array $match): string => blankOut($match[0]), $content);
    $segments = [];

    $html = $content;
    preg_match_all('/\{\{.*?\}\}|\{%.*?%\}/s', $content, $tags, \PREG_OFFSET_CAPTURE);
    foreach ($tags[0] as [$tag, $tagOffset]) {
        $isTemplateNameTag = 1 === preg_match('/^\{%-?\s*(\w+)/', $tag, $name) && \in_array($name[1], TEMPLATE_NAME_TAGS, true);
        preg_match_all('/"(?:[^"\\\\]|\\\\.)*"|\'(?:[^\'\\\\]|\\\\.)*\'/s', $tag, $literals, \PREG_OFFSET_CAPTURE);
        $literalsToScan = $isTemplateNameTag ? \array_slice($literals[0], 1) : $literals[0];
        foreach ($literalsToScan as [$literal, $offset]) {
            $segments[] = [lineAt($content, $tagOffset + $offset), $literal];
        }
        $html = substr_replace($html, blankOut($tag), $tagOffset, \strlen($tag));
    }

    $html = (string) preg_replace_callback('/<(script|style)\b[^>]*>.*?<\/\1>/is', static fn (array $match): string => blankOut($match[0]), $html);

    $cursor = 0;
    preg_match_all('/<[^>]*>/s', $html, $htmlTags, \PREG_OFFSET_CAPTURE);
    foreach ($htmlTags[0] as [$htmlTag, $tagOffset]) {
        $segments[] = [lineAt($html, $cursor), substr($html, $cursor, $tagOffset - $cursor)];
        $cursor = $tagOffset + \strlen($htmlTag);

        preg_match_all('/([\w:.-]+)\s*=\s*("[^"]*"|\'[^\']*\')/', $htmlTag, $attributes, \PREG_OFFSET_CAPTURE);
        foreach ($attributes[1] as $index => [$attributeName]) {
            if (\in_array(strtolower($attributeName), COPY_ATTRIBUTES, true)) {
                [$value, $valueOffset] = $attributes[2][$index];
                $segments[] = [lineAt($html, $tagOffset + $valueOffset), $value];
            }
        }
    }
    $segments[] = [lineAt($html, $cursor), substr($html, $cursor)];

    return $segments;
}

/**
 * @return list<array{int, string}> line, value of each YAML translation entry (keys and comments left out)
 */
function yamlCopy(string $content): array
{
    $segments = [];
    $blockIndent = null;
    foreach (explode("\n", $content) as $index => $line) {
        $indent = \strlen($line) - \strlen(ltrim($line));
        if (null !== $blockIndent) {
            if ('' === trim($line) || $indent > $blockIndent) {
                $segments[] = [$index + 1, $line];
                continue;
            }
            $blockIndent = null;
        }
        if ('' === trim($line) || str_starts_with(ltrim($line), '#')) {
            continue;
        }
        if (1 !== preg_match('/^\s*(?:-\s+)?(?:(?:"[^"]*"|\'[^\']*\'|[^\s:#"\'][^:#]*?)\s*:(?:\s+|$))?(.*)$/', $line, $match)) {
            continue;
        }
        $value = $match[1];
        if (1 === preg_match('/^[|>][+-]?\d*\s*$/', $value)) {
            $blockIndent = $indent;
            continue;
        }
        if (!str_starts_with($value, '"') && !str_starts_with($value, "'")) {
            $value = (string) preg_replace('/\s+#.*$/', '', $value);
        }
        if ('' !== trim($value)) {
            $segments[] = [$index + 1, $value];
        }
    }

    return $segments;
}

/**
 * @return list<array{int, string}> line, text of each <source> and <target>
 */
function xliffCopy(string $content): array
{
    preg_match_all('/<(source|target)\b[^>]*>(.*?)<\/\1>/s', $content, $matches, \PREG_OFFSET_CAPTURE);
    $segments = [];
    foreach ($matches[2] as [$text, $offset]) {
        $segments[] = [lineAt($content, $offset), $text];
    }

    return $segments;
}

/**
 * @param array<string, string> $bannedPhrases
 *
 * @return list<array{int, string, string}> line, phrase as written, instead
 */
function findBannedPhrases(string $absolute, array $bannedPhrases): array
{
    $content = (string) file_get_contents($absolute);
    $segments = match (strtolower(pathinfo($absolute, \PATHINFO_EXTENSION))) {
        'twig' => twigCopy($content),
        'xlf' => xliffCopy($content),
        default => yamlCopy($content),
    };

    $hits = [];
    foreach ($segments as [$firstLine, $text]) {
        foreach ($bannedPhrases as $phrase => $instead) {
            $pattern = '/(?<!\w)'.str_replace(' ', '\s+',preg_quote($phrase, '/')).'s?(?!\w)/iu';
            preg_match_all($pattern, $text, $matches, \PREG_OFFSET_CAPTURE);
            foreach ($matches[0] as [$found, $offset]) {
                $hits[] = [$firstLine + substr_count($text, "\n", 0, $offset), (string) preg_replace('/\s+/', ' ', $found), $instead];
            }
        }
    }

    return $hits;
}

function relativeTo(string $root, string $absolute): string
{
    $absolute = str_replace('//', '/', $absolute);

    return str_starts_with($absolute, $root.'/') ? substr($absolute, \strlen($root) + 1) : $absolute;
}

/**
 * Only paths inside the repository can be skipped: a folder named var outside it is not ours.
 */
function isSkipped(string $relative): bool
{
    if (str_starts_with($relative, '/')) {
        return false;
    }
    foreach (SKIPPED_FOLDERS as $folder) {
        if (str_starts_with($relative, $folder.'/') || str_contains($relative, '/'.$folder.'/')) {
            return true;
        }
    }

    return false;
}

/**
 * @param list<string> $extensions
 *
 * @return list<string> absolute paths of the files at or under $absolute with one of the extensions
 */
function collectFiles(string $root, string $absolute, array $extensions): array
{
    if (is_file($absolute)) {
        return [$absolute];
    }

    $files = [];
    $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($absolute, FilesystemIterator::SKIP_DOTS));
    foreach ($iterator as $file) {
        \assert($file instanceof SplFileInfo);
        if (\in_array(strtolower($file->getExtension()), $extensions, true) && !isSkipped(relativeTo($root, $file->getPathname()))) {
            $files[] = $file->getPathname();
        }
    }

    return $files;
}

$root = \dirname(__DIR__);
$arguments = \array_slice($argv, 1);
$glossary = $root.'/'.GLOSSARY_FILE;
if (($arguments[0] ?? null) === '--glossary' && isset($arguments[1])) {
    $glossary = $arguments[1];
    $arguments = \array_slice($arguments, 2);
}

$glossaryWords = readGlossaryWords($glossary);
if ([] === $glossaryWords) {
    fwrite(\STDERR, \sprintf("%s: no table with banned words under \"%s\". bin/lint-copy reads the \"Avoid\" column of that table.\n", $glossary, GLOSSARY_HEADING));
    exit(2);
}
$bannedPhrases = $glossaryWords + STATUS_JARGON;

/** @var array<string, list<string>> $scans path => extensions to collect */
$scans = [];
if ([] === $arguments) {
    $scans = [$root.'/src' => ['twig'], $root.'/templates' => ['twig'], $root.'/translations' => ['yaml', 'yml', 'xlf']];
    $scans = array_filter($scans, 'file_exists', \ARRAY_FILTER_USE_KEY);
} else {
    $missingPaths = [];
    foreach ($arguments as $path) {
        $absolute = str_starts_with($path, '/') ? $path : $root.'/'.$path;
        file_exists($absolute) ? $scans[$absolute] = COPY_EXTENSIONS : $missingPaths[] = $path;
    }
    if ([] !== $missingPaths) {
        foreach ($missingPaths as $path) {
            fwrite(\STDERR, \sprintf("%s: no such file or folder\n", $path));
        }
        exit(2);
    }
}

$files = [];
foreach ($scans as $absolute => $extensions) {
    foreach (collectFiles($root, (string) $absolute, $extensions) as $file) {
        $relative = relativeTo($root, $file);
        if ([] === $arguments && str_starts_with($relative, OWN_FIXTURE_FOLDER.'/')) {
            continue;
        }
        $files[$relative] = $file;
    }
}
ksort($files);

$hitCount = 0;
foreach ($files as $relative => $absolute) {
    $hits = findBannedPhrases($absolute, $bannedPhrases);
    sort($hits);
    foreach (array_unique($hits, \SORT_REGULAR) as [$line, $phrase, $instead]) {
        fwrite(\STDOUT, \sprintf("%s:%d: \"%s\" — say \"%s\"\n", $relative, $line, $phrase, $instead));
        ++$hitCount;
    }
}

if ($hitCount > 0) {
    fwrite(\STDERR, \sprintf("%d banned phrase(s) in user-visible copy. Use the words in \"%s\" in %s, and keep workflow-status jargon out.\n", $hitCount, GLOSSARY_HEADING, GLOSSARY_FILE));
    exit(1);
}
