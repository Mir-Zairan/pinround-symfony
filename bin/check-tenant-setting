#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * CI check for the tenant setting (ADR-0005). Prints `file:line: text` for every violation and exits 1.
 *
 * The tenant setting is named either literally (app.org_id, optionally quoted, quotes optionally backslash-escaped)
 * or through a PHP constant concatenated into the string (TenantSetting::NAME, self::NAME), the quotes around the
 * concatenation optionally backslash-escaped too. Bans, case-insensitive
 * and with any whitespace:
 * - `SET`, `SET LOCAL`, `SET SESSION` and `RESET` of the setting;
 * - any set_config for the setting whose third argument is anything but the bare word true, in every file;
 * - any set_config for the setting in a file outside ALLOWED_SET_CONFIG_FILES.
 * Reading with current_setting('app.org_id', true) is not a set and passes.
 *
 * Usage: bin/check-tenant-setting [path...]. Without paths it scans the repository folders in DEFAULT_PATHS,
 * minus its own fixture folder. vendor/ and var/ are never scanned. In folders it reads files with a
 * SCANNED_EXTENSIONS extension, and files without an extension that start with `#!` or `<?php`.
 * Exits 1 on a violation, 2 when a given path does not exist.
 */
const DEFAULT_PATHS = ['src', 'config', 'migrations', 'docker', 'tests', 'bin'];
const SCANNED_EXTENSIONS = ['sql', 'php', 'yaml', 'yml', 'sh', 'neon'];
const SKIPPED_FOLDERS = ['vendor', 'var'];
const OWN_FIXTURE_FOLDER = 'tests/Fixtures/TenantSetting';

/**
 * Where a set_config(..., true) for the tenant may appear: the statement itself, the middleware that documents it,
 * the tests that assert or simulate it, and this check's own error message.
 */
const ALLOWED_SET_CONFIG_FILES = [
    'src/SharedKernel/Infrastructure/Doctrine/TenantConnection.php',
    'src/SharedKernel/Infrastructure/Doctrine/TenantMiddleware.php',
    'tests/Unit/SharedKernel/Infrastructure/Doctrine/TenantMiddlewareTest.php',
    'tests/Integration/Tenancy/SetTenantFailsOnceMiddleware.php',
    'tests/Fixtures/Http/RequestTransactionProbeController.php',
    'bin/check-tenant-setting',
];

const QUOTE = '\\\\?[\'"]';
const NAME_CONSTANT = '(?:'.QUOTE.')+\s*\.\s*[\w\\\\]+::NAME\b';
const TENANT_NAME = '(?:'.QUOTE.'app\.org_id'.QUOTE.'|'.NAME_CONSTANT.'(?:\s*\.\s*(?:'.QUOTE.')+)?)';
const SET_STATEMENT = '/\b(?:SET|RESET)\s+(?:(?:LOCAL|SESSION)\s+)?(?:(?:'.QUOTE.')?app\.org_id\b|'.NAME_CONSTANT.')/i';
const SET_CONFIG_CALL = '/set_config\s*\(\s*'.TENANT_NAME.'/i';
// The second argument may hold one level of parentheses but never closes the call, so a mention such as
// "set_config('app.org_id', …)" in a comment does not run on to a comma further down the file. The whitespace
// sits inside the lookahead so backtracking cannot skip it and see " true)" as not-true.
const SET_CONFIG_NOT_TRANSACTION_LOCAL = '/set_config\s*\(\s*'.TENANT_NAME.'\s*,(?:[^,;()]|\([^()]*\))*,(?!\s*true\s*\))/i';

/**
 * @return list<string> repository-relative file paths
 */
function collectFiles(string $root, string $absolute): array
{
    if (is_file($absolute)) {
        return [relativeTo($root, $absolute)];
    }

    $files = [];
    $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($absolute, FilesystemIterator::SKIP_DOTS));
    foreach ($iterator as $file) {
        \assert($file instanceof SplFileInfo);
        $relative = relativeTo($root, $file->getPathname());
        if (isSkipped($relative) || !isScanned($file)) {
            continue;
        }
        $files[] = $relative;
    }

    return $files;
}

function isScanned(SplFileInfo $file): bool
{
    if ('' !== $file->getExtension()) {
        return \in_array($file->getExtension(), SCANNED_EXTENSIONS, true);
    }
    $start = (string) file_get_contents($file->getPathname(), false, null, 0, 5);

    return str_starts_with($start, '#!') || '<?php' === $start;
}

function relativeTo(string $root, string $absolute): string
{
    $absolute = str_replace('//', '/', $absolute);

    return str_starts_with($absolute, $root.'/') ? substr($absolute, \strlen($root) + 1) : $absolute;
}

function isSkipped(string $relative): bool
{
    foreach (SKIPPED_FOLDERS as $folder) {
        if (str_starts_with($relative, $folder.'/') || str_contains($relative, '/'.$folder.'/')) {
            return true;
        }
    }

    return false;
}

/**
 * @return array<int, string> line number => rule that matched first on that line
 */
function findViolations(string $relative, string $content): array
{
    $rules = [
        SET_STATEMENT => true,
        SET_CONFIG_NOT_TRANSACTION_LOCAL => true,
        SET_CONFIG_CALL => !\in_array($relative, ALLOWED_SET_CONFIG_FILES, true),
    ];

    $violations = [];
    foreach ($rules as $pattern => $applies) {
        if (!$applies || false === preg_match_all($pattern, $content, $matches, \PREG_OFFSET_CAPTURE)) {
            continue;
        }
        foreach ($matches[0] as [, $offset]) {
            $line = substr_count($content, "\n", 0, $offset) + 1;
            $violations[$line] ??= $pattern;
        }
    }
    ksort($violations);

    return $violations;
}

$root = \dirname(__DIR__);
$arguments = \array_slice($argv, 1);
$paths = [] === $arguments ? DEFAULT_PATHS : $arguments;

$absolutePaths = [];
foreach ($paths as $path) {
    $absolutePaths[$path] = str_starts_with($path, '/') ? $path : $root.'/'.$path;
}
$missingPaths = array_keys(array_filter($absolutePaths, static fn (string $absolute): bool => !file_exists($absolute)));
if ([] !== $missingPaths) {
    foreach ($missingPaths as $path) {
        fwrite(\STDERR, \sprintf("%s: no such file or folder\n", $path));
    }
    exit(2);
}

$files = [];
foreach ($absolutePaths as $absolute) {
    foreach (collectFiles($root, $absolute) as $file) {
        if ([] === $arguments && str_starts_with($file, OWN_FIXTURE_FOLDER.'/')) {
            continue;
        }
        $files[$file] = true;
    }
}
ksort($files);

$violationCount = 0;
foreach (array_keys($files) as $file) {
    $content = (string) file_get_contents($root.'/'.$file);
    $lines = explode("\n", $content);
    foreach (findViolations($file, $content) as $line => $pattern) {
        fwrite(\STDOUT, \sprintf("%s:%d: %s\n", $file, $line, trim($lines[$line - 1] ?? '')));
        ++$violationCount;
    }
}

if ($violationCount > 0) {
    fwrite(\STDERR, \sprintf("%d tenant setting violation(s). Only set_config('app.org_id', ?, true) through the DBAL tenant middleware is allowed (ADR-0005).\n", $violationCount));
    exit(1);
}
