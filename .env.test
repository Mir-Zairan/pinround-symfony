# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

DEFAULT_URI=http://localhost
# SecurityHeadersTest expects these origins in the CSP.
MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000
# The test env appends "_test" to the database name; `make db-roles` sets the same passwords.
DATABASE_URL="postgresql://pinround_app:change-me-dev-only-app-db@postgres:5432/pinround?serverVersion=18&charset=utf8"
MIGRATOR_DATABASE_URL="postgresql://pinround_migrator:change-me-dev-only-migrator-db@postgres:5432/pinround?serverVersion=18&charset=utf8"
READONLY_DATABASE_URL="postgresql://pinround_readonly:change-me-dev-only-readonly-db@postgres:5432/pinround?serverVersion=18&charset=utf8"
MAILER_DSN=null://null
MAILER_FROM="pinround <no-reply@pinround.localhost>"
MESSENGER_TRANSPORT_DSN=in-memory://
# What /health/ready checks in HealthTest: the compose stack's MinIO and Valkeys (the cache one is not used as a
# cache in tests, and the state one stands in for MESSENGER_TRANSPORT_DSN's host).
OBJECT_STORAGE_ENDPOINT=http://minio:9000
REDIS_CACHE_DSN=redis://valkey-cache:6379
TEST_STATE_VALKEY_DSN=redis://valkey-state:6379
