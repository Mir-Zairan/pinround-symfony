{
	# Keeps the internal CA out of the container trust store; browsers and curl -k still accept localhost.
	skip_install_trust

	# The prod image sets CADDY_ADMIN=off: nothing there may change the running config. Dev keeps it on localhost:2019.
	admin {$CADDY_ADMIN:localhost:2019}

	# Request metrics, served only on the admin endpoint (/metrics), so in dev only. The container healthcheck
	# probes /health/live instead.
	metrics

	frankenphp
}

# The one built-in hub, on the plain-HTTP address the workers publish to over the compose network (compose.yaml's
# MERCURE_URL). Caddy runs each listening port as its own server with its own copy of a site's handlers, and refuses
# a second unnamed hub, while a named one would be a second hub no browser listens to; so browsers reach this same hub
# through SERVER_NAME's proxy below.
http://{$MERCURE_INTERNAL_HOST:app}:80 {
	mercure {
		# The `aud` every token must carry. Unpinned, the hub would expect the URL each request reached, which is
		# http://app here for both workers and the proxied browsers. No default: an unset value stops Caddy from starting.
		resource_identifier {$MERCURE_PUBLIC_URL}
		issuer {$MERCURE_TRUSTED_ISSUERS:https://localhost} {
			publisher {
				jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
			}
			subscriber {
				jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
			}
		}
	}
	# Only the hub: the app itself stays behind SERVER_NAME's HTTPS.
	respond 404
}

# Dev-only sites (the HTTPS proxy to MinIO), mounted by compose.yaml. A glob, so the prod image, which has no such
# folder, starts with a warning instead of an error.
import /etc/caddy/dev.d/*.caddy

# One host name: the Dockerfile healthcheck connects to it.
{$SERVER_NAME:localhost} {
	# No `log` directive on purpose: Caddy writes no access log, so no request URI (the tickets list's ?q= holds search
	# words, ADR-0027) reaches one. A `log` added here must drop it, for example with
	# `format filter { request>uri query { replace q [removed] } }` (security.md "Logging without leaking").
	root * /app/public

	# Compressed SSE streams cost memory per subscriber and enable BREACH-style attacks.
	@compressible not path /.well-known/mercure
	encode @compressible zstd br gzip

	# AssetMapper file names carry a content hash, so they never change.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Browsers subscribe here (MERCURE_PUBLIC_URL); the subscriber cookie is scoped to this path. Caddy streams
	# text/event-stream answers through without buffering.
	reverse_proxy /.well-known/mercure* 127.0.0.1:80 {
		header_up Host {$MERCURE_INTERNAL_HOST:app}
	}

	php_server {
		root /app/public
		worker {
			file /app/public/index.php
			num {$FRANKENPHP_WORKER_COUNT:2}
			env FRANKENPHP_WORKER 1
			# Dev sets this to `watch` so code edits on the bind mount restart the workers; empty in prod.
			{$FRANKENPHP_WORKER_CONFIG:}
			# FrankenPHP 1.13 has no max_requests directive; the Symfony Runtime restarts the worker after this many requests.
			env FRANKENPHP_LOOP_MAX 500
		}
	}
}
