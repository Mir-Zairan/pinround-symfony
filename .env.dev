# Dev-only values. Never loaded in prod; they hold no real secrets.

# Change me, dev only: placeholder secret and keys of the local app and Mercure hub.
APP_SECRET=change-me-dev-only-app-secret
MERCURE_PUBLISHER_JWT_KEY=change-me-dev-only-publisher-key-32b
MERCURE_SUBSCRIBER_JWT_KEY=change-me-dev-only-subscriber-key-32

DEFAULT_URI=http://localhost

# Dev-only credentials of the local postgres container; `make db-roles` sets the same passwords.
# The app runs as pinround_app; migrations run as pinround_migrator through the "migrator" connection.
DATABASE_URL="postgresql://pinround_app:change-me-dev-only-app-db@postgres:5432/pinround?serverVersion=18&charset=utf8"
MIGRATOR_DATABASE_URL="postgresql://pinround_migrator:change-me-dev-only-migrator-db@postgres:5432/pinround?serverVersion=18&charset=utf8"
MAILER_DSN=smtp://mailpit:1025
MESSENGER_TRANSPORT_DSN=redis://valkey-state:6379/messages
REDIS_CACHE_DSN=redis://valkey-cache:6379
