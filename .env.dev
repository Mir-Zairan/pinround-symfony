# Dev-only values. Never loaded in prod; they hold no real secrets.

# Change me, dev only: placeholder secret and keys of the local app and Mercure hub.
APP_SECRET=change-me-dev-only-app-secret
MERCURE_PUBLISHER_JWT_KEY=change-me-dev-only-publisher-key-32b
MERCURE_SUBSCRIBER_JWT_KEY=change-me-dev-only-subscriber-key-32

# Change me, dev only: the field encryption key is base64 of the text "change-me-dev-only-field-key-32b".
FIELD_ENCRYPTION_KEYS=change-me-dev:Y2hhbmdlLW1lLWRldi1vbmx5LWZpZWxkLWtleS0zMmI=
FIELD_ENCRYPTION_CURRENT_KEY_ID=change-me-dev
# Change me, dev only: the pepper of personal access token hashes.
API_TOKEN_PEPPER=change-me-dev-only-api-token-pepper-32b

DEFAULT_URI=http://localhost
# The FrankenPHP built-in hub and the MinIO API port on the host (CSP connect-src and img-src).
MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
OBJECT_STORAGE_PUBLIC_URL=http://localhost:9000
# The same MinIO from inside the compose network (/health/ready).
OBJECT_STORAGE_ENDPOINT=http://minio:9000
# Change me, dev only: the local MinIO's bucket and root credentials (compose.yaml, x-minio-credentials).
OBJECT_STORAGE_BUCKET=pinround
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=pinround-dev
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me-dev-only-minio

# Dev-only credentials of the local postgres container; `make db-roles` sets the same passwords.
# The app runs as pinround_app; migrations run as pinround_migrator through the "migrator" connection.
DATABASE_URL="postgresql://pinround_app:change-me-dev-only-app-db@postgres:5432/pinround?serverVersion=18&charset=utf8"
MIGRATOR_DATABASE_URL="postgresql://pinround_migrator:change-me-dev-only-migrator-db@postgres:5432/pinround?serverVersion=18&charset=utf8"
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM="pinround <no-reply@pinround.localhost>"
# No stream in the path: each async_* transport names its own (messenger.yaml).
MESSENGER_TRANSPORT_DSN=redis://valkey-state:6379
REDIS_CACHE_DSN=redis://valkey-cache:6379
# Sessions and the login counters.
STATE_VALKEY_DSN=redis://valkey-state:6379
