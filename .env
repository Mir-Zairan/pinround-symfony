# Committed defaults shared by every environment. They hold no secrets.
# Dev and test values (database, mail, queue, Mercure placeholders) live in .env.dev and .env.test,
# so a prod image never inherits them: prod gets them from real environment variables or secrets.
# Override per machine in .env.local (git-ignored).
# https://symfony.com/doc/current/configuration/secrets.html

###> docker ###
# Host ports of the app container; a developer overrides them in the git-ignored .env.local.
HTTP_PORT=80
HTTPS_PORT=443
SERVER_NAME=localhost
FRANKENPHP_WORKER_COUNT=2
# Host ports of the support services (bound to 127.0.0.1 only).
# MinIO S3 API
MINIO_API_PORT=9000
# MinIO web console
MINIO_CONSOLE_PORT=9001
# Mailpit web UI (SMTP stays inside the compose network)
MAILPIT_UI_PORT=8025
###< docker ###

###> mercure ###
# Empty on purpose: the prod container refuses to start until real keys are set.
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_PUBLISHER_JWT_ALG=HS256
MERCURE_SUBSCRIBER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_ALG=HS256
###< mercure ###

###> valkey ###
# Empty on purpose: dev gets it from .env.dev; prod must set the valkey-cache DSN, because cache.app reads it.
REDIS_CACHE_DSN=
###< valkey ###

###> symfony/framework-bundle ###
APP_ENV=dev
# Empty on purpose: set a random value in .env.local or in Symfony secrets.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###
