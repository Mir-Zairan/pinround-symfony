# Committed defaults shared by every environment. They hold no secrets.
# Dev and test values (database, mail, queue, Mercure placeholders) live in .env.dev and .env.test,
# so a prod image never inherits them: prod gets them from real environment variables or secrets.
# Override per machine in .env.local (git-ignored).
# https://symfony.com/doc/current/configuration/secrets.html

###> docker ###
# Host ports of the app container; a developer overrides them in the git-ignored .env.local.
HTTP_PORT=80
HTTPS_PORT=443
SERVER_NAME=localhost
FRANKENPHP_WORKER_COUNT=2
# Host ports of the support services (bound to 127.0.0.1 only).
# MinIO S3 API
MINIO_API_PORT=9000
# MinIO web console
MINIO_CONSOLE_PORT=9001
# Mailpit web UI (SMTP stays inside the compose network)
MAILPIT_UI_PORT=8025
###< docker ###

###> mercure ###
# Empty on purpose: the prod container refuses to start until real keys are set.
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_PUBLISHER_JWT_ALG=HS256
MERCURE_SUBSCRIBER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_ALG=HS256
# The hub URL browsers subscribe to; its origin joins the CSP connect-src. Empty adds no source. It is also the
# audience of every token the app signs, which the hub pins (the Caddyfile's resource_identifier).
MERCURE_PUBLIC_URL=
# The hub URL worker-notify publishes to (config/packages/mercure.yaml). Required wherever RefreshTicketPages is
# handled: empty makes the bundle publish through FrankenPHP's own hub, which works only inside the app container's
# requests, so every refresh in worker-notify fails.
MERCURE_URL=
# The issuer the hub trusts (the Caddyfile's MERCURE_TRUSTED_ISSUERS), put in every token the app signs.
MERCURE_JWT_ISSUER=https://localhost
###< mercure ###

###> object storage ###
# The bucket's own public URL (never a shared host like *.amazonaws.com); its origin joins the CSP img-src and connect-src.
# Required for Media storage (ObjectStorageSettings refuses it empty); empty on purpose here, and the CSP then adds
# no source. Presigned upload URLs are signed for this host, path-style: {this URL}/{bucket}/{key}.
OBJECT_STORAGE_PUBLIC_URL=
# The endpoint the app reaches the storage at on its own network (for example http://minio:9000); /health/ready
# fails until it is set.
OBJECT_STORAGE_ENDPOINT=
# Empty on purpose: dev and test get them from .env.dev and .env.test; prod must set them (the secret as a secret).
# Media refuses to build its storage services while one is empty (ObjectStorageSettings).
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
###< object storage ###

###> valkey ###
# Empty on purpose: dev gets it from .env.dev; prod must set the valkey-cache DSN, because cache.app reads it.
REDIS_CACHE_DSN=
# Empty on purpose: dev gets it from .env.dev; prod must set the valkey-state DSN, because sessions and the login
# counters live there.
STATE_VALKEY_DSN=
###< valkey ###

###> symfony/framework-bundle ###
APP_ENV=dev
# Empty on purpose: dev gets it from .env.dev. Prod must pass APP_SECRET as an environment variable (the prod entrypoint reads only the environment).
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> field encryption ###
# Empty on purpose: dev and test get throwaway keys from .env.dev and .env.test; prod sets both from its secret store
# as plain environment variables, not Symfony secrets: the entrypoint guard reads only the environment (ADR-0027). The keys: a comma list of <id>:<base64 of 32 random bytes>; make a key with
# `php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'`. The current id names the key new writes use; keep older
# keys in the list while stored values still use them. Read on the first encrypt or decrypt, not at boot.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_CURRENT_KEY_ID=
###< field encryption ###

###> personal access tokens ###
# Empty on purpose: dev and test get throwaway values from .env.dev and .env.test; prod sets it from its secret store.
# The pepper of every stored token hash (ADR-0021), at least 32 bytes; make one with
# `php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'`. Changing it makes every issued token stop working.
API_TOKEN_PEPPER=
###< personal access tokens ###

###> open-telemetry ###
# Tracing is off while the endpoint is empty. Set it to the OTLP receiver's base URL (for example http://collector:4318);
# spans go to its /v1/traces over OTLP/HTTP in batches after the response is sent, each HTTP call capped at 1 second, and are dropped when it fails.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Local example, in .env.local (needs `docker compose --profile observability up`; UI at http://localhost:16686):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# http/protobuf or http/json
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=pinround
# Head sampling ratio (0 to 1): every request starts a new trace (no incoming trace header is read), and this share of them is
# exported. Use 0.1 in prod.
OTEL_TRACES_SAMPLER_ARG=1.0
###< open-telemetry ###

###> server-side AI ###
# The operator's Hugging Face token, used when an organization has no key of its own; empty turns Hugging Face off.
AI_HUGGINGFACE_TOKEN=
# The operator's Anthropic API key, used when an organization has no key of its own; empty turns Anthropic off.
AI_ANTHROPIC_KEY=
# Base URL of the operator-run Ollama server (for example http://ollama:11434), never a tenant setting; empty turns it off.
AI_OLLAMA_URL=
###< server-side AI ###
