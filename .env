# Committed defaults for local development only. They hold no real secrets.
# Override per machine in .env.local (git-ignored) and in real environment variables.
# Production secrets come from Symfony secrets or the environment, never from this file.
# https://symfony.com/doc/current/configuration/secrets.html

###> docker ###
# Host ports of the app container; a developer overrides them in the git-ignored .env.local.
HTTP_PORT=80
HTTPS_PORT=443
SERVER_NAME=localhost
FRANKENPHP_WORKER_COUNT=2
###< docker ###

###> mercure ###
# Change me, dev only: placeholder keys of the local Mercure hub. Real keys come from secrets.
MERCURE_PUBLISHER_JWT_KEY=change-me-dev-only-publisher-key-32b
MERCURE_PUBLISHER_JWT_ALG=HS256
MERCURE_SUBSCRIBER_JWT_KEY=change-me-dev-only-subscriber-key-32
MERCURE_SUBSCRIBER_JWT_ALG=HS256
###< mercure ###

###> symfony/framework-bundle ###
APP_ENV=dev
# Empty on purpose: set a random value in .env.local or in Symfony secrets.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Dev-only credentials of the local postgres container.
DATABASE_URL="postgresql://pinround:pinround@postgres:5432/pinround?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=redis://valkey-state:6379/messages
###< symfony/messenger ###
