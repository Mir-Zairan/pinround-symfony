<turbo-stream action="replace" target="{{ pingTargetId }}"><template>{{ include('@Notification/_pinged.html.twig') }}</template></turbo-stream>
{%- endif -%}
{{ include('@Web/_toast_stream.html.twig', {message: toast}) }}
