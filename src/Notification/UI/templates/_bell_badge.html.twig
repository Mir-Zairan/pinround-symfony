{#- The bell's count of open notifications, which a stream answer replaces by its id. The number is drawn for the eye;
    the button's name takes the spoken count after its own word, so a screen reader reads "Pings 3 open". -#}
<span id="bell-badge">
    {%- if openCount > 0 -%}
        <span class="badge bell__badge" aria-hidden="true">{{ openCount > 99 ? '99+' : openCount }}</span>
        <span class="visually-hidden">{{ openCount }} open</span>
    {%- endif -%}
</span>
