<!DOCTYPE html>
{#- A page's own theme (the gallery's ?theme=) wins over the user's saved one; "system" prints nothing, so the
    prefers-color-scheme media query decides. -#}
{%- set pageTheme = theme ?? (app.user ? app.user.theme : null) -%}
<html lang="en"{% if pageTheme in ['light', 'dark'] %} data-theme="{{ pageTheme }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}pinround{% endblock %}</title>
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ asset('fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2') }}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ asset('fonts/atkinson-hyperlegible-mono-latin-wght-normal.woff2') }}">
    <link rel="stylesheet" href="{{ asset('styles/tokens.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/shell.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/components.css') }}">
    {% block stylesheets %}{% endblock %}
    {{ importmap('app', {nonce: csp_nonce()}) }}
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="app">
        {% block site_header %}
        <header class="site-header">
            <div class="site-header__inner">
                <a class="logo" href="{{ path('web_home') }}">
                    {%- block logo %}
                    <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
                        <rect class="logo__mark" x="1" y="1" width="24" height="24" rx="7"/>
                        <circle class="logo__dot" cx="13" cy="11.5" r="4.5"/>
                        <path class="logo__stem" d="M13 16v5" stroke-width="2.2" stroke-linecap="round"/>
                    </svg>
                    pinround
                    {% endblock -%}
                </a>
                <nav class="site-header__nav" aria-label="Main">
                    <a class="nav" href="{{ path('web_home') }}"{% if app.current_route == 'web_home' %} aria-current="page"{% endif %}>Home</a>
                </nav>
                <div class="site-header__spacer"></div>
                {# TODO(P01.T5): wire the report button and the bell once pings exist. #}
                <button type="button" class="btn btn-tonal btn-sm">Report a problem</button>
                <button type="button" class="icon-btn" aria-label="Pings">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
                        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
                    </svg>
                </button>
                {% if app.user %}
                    {# A disclosure, not an ARIA menu: it holds links, a switch and a form. "menu" opens and closes it. #}
                    <div class="menu avatar-menu" {{ stimulus_controller('menu') }} data-action="focusout->menu#closeOnFocusLeave">
                        <button type="button" class="avatar-menu__trigger" aria-expanded="false" aria-controls="avatar-menu-list"
                            {{ stimulus_target('menu', 'trigger') }} data-action="menu#toggle keydown->menu#triggerKey click@window->menu#closeOnOutsideClick">
                            <twig:Avatar name="{{ app.user.name }}" :isInHeader="true" title="{{ app.user.name }}"/>
                        </button>
                        <div id="avatar-menu-list" class="menu__list avatar-menu__list" hidden
                            {{ stimulus_target('menu', 'list') }} data-action="keydown->menu#closeOnEscape">
                            {# Only for a user in two or more organizations; the name is missing on pages without one, such as the picker. #}
                            {% if can_switch_organization() %}
                                {% set organizationName = current_organization_name() %}
                                {% if organizationName %}
                                    <p class="avatar-menu__organization">
                                        <span class="avatar-menu__label">Organization</span>
                                        <span class="avatar-menu__organization-name">{{ organizationName }}</span>
                                    </p>
                                {% endif %}
                                <a class="menu__item" href="{{ path('organization_choose') }}" {{ stimulus_target('menu', 'item') }}>Switch organization</a>
                            {% endif %}
                            <a class="menu__item" href="{{ path('identity_profile') }}" {{ stimulus_target('menu', 'item') }}>Profile</a>
                            <a class="menu__item" href="{{ path('identity_security') }}" {{ stimulus_target('menu', 'item') }}>Security</a>
                            <form class="avatar-menu__theme" method="post" action="{{ path('identity_theme') }}" {{ stimulus_controller('theme-switch') }} data-action="click->theme-switch#choose">
                                <span class="avatar-menu__label" aria-hidden="true">Theme</span>
                                <twig:SegmentedControl label="Theme" :options="{system: 'System', light: 'Light', dark: 'Dark'}" selected="{{ app.user.theme }}"/>
                                <input type="hidden" name="theme" value="{{ app.user.theme }}" {{ stimulus_target('theme-switch', 'choice') }}>
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('identity_theme') }}">
                            </form>
                            <form method="post" action="{{ path('identity_logout') }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                <button type="submit" class="menu__item avatar-menu__log-out" {{ stimulus_target('menu', 'item') }}>Log out</button>
                            </form>
                        </div>
                    </div>
                {% else %}
                    {# No user: a page open without a login, which is only the component gallery in dev and test. #}
                    <span class="site-header__avatar" aria-hidden="true"></span>
                {% endif %}
            </div>
        </header>
        {% endblock %}
        <main id="main" class="page">{% block main %}{% endblock %}</main>
        <div class="toast-region" role="status" aria-live="polite"></div>
        <div id="dialog-root"></div>
    </div>
</body>
</html>
