{% extends '@Web/base.html.twig' %}

{% block head %}
    {# Turbo must not show a cached copy of Home (frontend.md, Turbo and real-time updates). #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/home.css') }}">
{% endblock %}

{#- The chips narrow the page: a section whose group is not the pressed chip carries `hidden` from the server, so the
    page opens on the saved chip with no flash. Without the script, each chip submits its form and Home reloads. -#}
{% block main %}
    {%- set chipLabels = {all: 'All', my_work: 'My work', my_team: 'My team', all_teams: 'All teams', admin: 'Admin'} -%}
    {%- set firstName = app.user.name|split(' ')|first -%}
    <div class="home" {{ stimulus_controller('focus-chips') }}>
        <header class="home__header">
            <p class="home__date">{{ today|date('l, j F', app.user.timeZone) }}</p>
            <h1 class="home__title">
                {%- if waitingCount == 0 -%}
                    All clear, {{ firstName }}
                {%- elseif waitingCount == 1 -%}
                    1 ticket waits on you, {{ firstName }}
                {%- else -%}
                    {{ waitingCount|number_format }} tickets wait on you, {{ firstName }}
                {%- endif -%}
            </h1>
            {% include '@Web/home/_notices.html.twig' %}
            {% if notShownCount > 0 or isLead %}
                <p class="home__subline">
                    {%- if notShownCount > 0 %}Do the top {{ shownNeedsYouNow }} first. {% endif -%}
                    {%- if isLead %}You lead the team, so reviews, decisions and unclear new tickets come to you.{% endif -%}
                </p>
            {% endif %}
        </header>

        <form method="post" action="{{ path('web_home_focus') }}" data-action="click->focus-chips#choose" {{ stimulus_target('focus-chips', 'form') }}>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('web_home_focus') }}">
            <div class="home__chips" role="group" aria-label="Show on Home">
                {% for choice in choices %}
                    <twig:Chip type="submit" name="focus" value="{{ choice.value }}" :pressed="choice == focus" data-focus-chips-target="chip">{{ chipLabels[choice.value] }}</twig:Chip>
                {% endfor %}
            </div>
        </form>

        <div class="home__row">
            <div class="home__column home__column--main">
                {% embed '@Web/home/_section.html.twig' with {id: 'needs-you-now', title: 'Needs you now', group: 'my_work', focus: focus.value, needsYouNow: needsYouNow, waitingCount: waitingCount, notShownCount: notShownCount, seeAllUrl: seeAllUrl} only %}
                    {% block header_extra %}
                        {% if notShownCount > 0 %}
                            <span class="home__section-note">top {{ needsYouNow|length }} of {{ waitingCount|number_format }}</span>
                        {% endif %}
                        {% if needsYouNow is not empty %}
                            <span class="home__order-note"><twig:AiChip>AI ORDER</twig:AiChip> who is blocked, priority, release, how long it waits</span>
                        {% endif %}
                        {% if notShownCount > 0 %}
                            <twig:Button variant="text" size="sm" href="{{ seeAllUrl }}" class="home__see-all">See all</twig:Button>
                        {% endif %}
                    {% endblock %}
                    {% block body %}
                        {% if needsYouNow is empty %}
                            <twig:EmptyState message="Nothing waits on you right now."/>
                        {% else %}
                            {#- The Why line's wait counts from when the turn came to the person, not from the ticket's last
                                change, so it says that, dated in the person's time zone. No hover prefetch: each link would
                                cost a ticket page's queries. -#}
                            <ol class="home__needs" data-turbo-prefetch="false">
                                {% for card in needsYouNow %}
                                    {%- set waitReason = card.waitDays == 0 ? 'came to you today' : (card.waitDays > 7 ? 'with you for ' ~ card.waitDays ~ ' days' : 'came to you on ' ~ card.waitingSince|date('j M', app.user.timeZone)) -%}
                                    <li class="home__need{{ loop.first ? ' home__need--first' }}">
                                        <span class="home__rank" aria-hidden="true">{{ loop.index }}</span>
                                        <div class="home__need-body">
                                            <p class="home__need-ticket"><span class="home__need-key">{{ card.key }}</span> · <span class="home__need-title">{{ card.title }}</span></p>
                                            <h3 class="home__need-task">{{ card.task }}</h3>
                                            <p class="home__need-why"><span class="home__why-label">Why</span> <span class="home__need-reasons">{{ card.reasons|merge([waitReason])|join(' · ') }}</span></p>
                                        </div>
                                        <div class="home__need-side">
                                            <twig:Button variant="{{ loop.first ? 'filled' : 'tonal' }}" size="sm" href="{{ card.url }}" class="home__need-open">{{ card.openLabel }}<span class="visually-hidden"> {{ card.key }}</span></twig:Button>
                                            <span class="home__need-wait">{{ card.waitText }}</span>
                                        </div>
                                    </li>
                                {% endfor %}
                            </ol>
                        {% endif %}
                    {% endblock %}
                {% endembed %}
                {% embed '@Web/home/_section.html.twig' with {id: 'also-waiting', title: 'Also waiting on you', group: 'my_work', focus: focus.value, notShownCount: notShownCount} only %}
                    {% block body %}
                        {% if notShownCount == 0 %}
                            <twig:EmptyState message="Nothing else waits on you."/>
                        {% elseif notShownCount == 1 %}
                            <p class="home__also-waiting">1 more ticket waits on you.</p>
                        {% else %}
                            <p class="home__also-waiting">{{ notShownCount|number_format }} more tickets wait on you.</p>
                        {% endif %}
                    {% endblock %}
                {% endembed %}
            </div>
            <aside class="home__column home__column--aside" aria-label="More for you">
                {% if isAdmin %}
                    {% include '@Web/home/_section.html.twig' with {id: 'admin', title: 'Admin', group: 'admin', focus: focus.value, message: 'Nothing needs you as admin.', adminSettingsUrl: adminSettingsUrl} only %}
                {% endif %}
                {#- TODO(P07.T2): Pings for you, the top 3 groups of NotificationQueries::bell. Left out until then: an
                    empty state that reads no pings said "No open pings. Nice." while the bell held some. -#}
                {% if isLead %}
                    {% include '@Web/home/_section.html.twig' with {id: 'release', title: 'Release', group: 'my_team', focus: focus.value, message: 'Your team has no release yet.'} only %}
                {% endif %}
                {% embed '@Web/home/_section.html.twig' with {id: 'your-team', title: 'Your team', group: 'my_team', focus: focus.value, teamStacks: teamStacks} only %}
                    {% block body %}
                        {% if teamStacks is empty %}
                            <twig:EmptyState message="You are not in a team yet."/>
                        {% else %}
                            <ul class="home__team-stacks">
                                {% for team in teamStacks %}
                                    <li class="home__team-stack">
                                        {% if teamStacks|length > 1 %}
                                            <h3 class="home__team-stack-name">{{ team.name }}</h3>
                                        {% endif %}
                                        <twig:AvatarStack :names="team.names" />
                                        <twig:Button variant="text" size="sm" href="{{ team.url }}" class="home__team-link">{{ team.peopleText }} · see who has what</twig:Button>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% endblock %}
                {% endembed %}
            </aside>
        </div>

        {% if isManager %}
            {% include '@Web/home/_section.html.twig' with {id: 'all-teams', title: 'All teams · you are also a manager', group: 'all_teams', focus: focus.value, message: 'Every team\'s progress will show here.'} only %}
        {% endif %}
    </div>
{% endblock %}
