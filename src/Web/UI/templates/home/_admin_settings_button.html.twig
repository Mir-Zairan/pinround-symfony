{#- The button to the admin area (MainMenu::adminHomeUrl, `/admin`, which opens the first tab the person may open); `url`
    is null only without that route, and then the button stays inert, as the menu's item would. -#}
{% if url %}
    <twig:Button variant="{{ variant }}" size="{{ size }}" href="{{ url }}">{{ label }}</twig:Button>
{% else %}
    <twig:Button variant="{{ variant }}" size="{{ size }}" :disabled="true">{{ label }}<span class="visually-hidden"> (not built yet)</span></twig:Button>
{% endif %}
