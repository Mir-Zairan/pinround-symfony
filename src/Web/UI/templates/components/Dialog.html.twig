<div {{ stimulus_controller('dialog') }}>
    {% block trigger %}{% endblock %}
    <dialog id="{{ this.id }}" class="dialog" aria-labelledby="{{ this.id }}-title" {{ stimulus_target('dialog', 'dialog') }} data-action="pointerdown->dialog#rememberPress click->dialog#closeOnBackdrop">
        <div class="dialog__box">
            <div class="dialog__header">
                <h2 id="{{ this.id }}-title" class="dialog__title">{{ this.title }}</h2>
                <button type="button" class="icon-btn" aria-label="Close" {{ stimulus_action('dialog', 'close') }}>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18"/>
                    </svg>
                </button>
            </div>
            <div class="dialog__body">{% block content %}{% endblock %}</div>
            {% if block('actions')|trim is not empty %}<div class="dialog__actions">{% block actions %}{% endblock %}</div>{% endif %}
        </div>
    </dialog>
</div>
