<div{{ attributes.defaults({class: 'seg-group'}) }} role="group" aria-label="{{ this.label }}">
{%- for value, optionLabel in this.options -%}
<button type="button" class="seg" value="{{ value }}" aria-pressed="{{ (value ~ '') == this.selected ? 'true' : 'false' }}">{{ optionLabel }}</button>
{%- endfor -%}
</div>
