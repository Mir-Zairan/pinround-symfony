{% extends '@Web/base.html.twig' %}

{% block title %}My reports · pinround{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/my-reports.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/ping-sheet.css') }}">
{% endblock %}

{#- The cards of ReportCards (my-reports.md, Card). At most two buttons a card: Answer or "Ping <name>", and the "⋯"
    menu. Ping loads the ticket page's ping sheet into the card's frame and opens it there (PingController::sheet; without
    script it goes to the ticket's People); the menu holds only what the ticket page already does. -#}
{% macro cards(cards, stageLabels) %}
    {# No hover prefetch: each link would cost a ticket page's queries. #}
    <ul class="my-reports__rows" data-turbo-prefetch="false">
        {% for card in cards %}
            <li class="my-reports__card">
                <div class="my-reports__top">
                    <a class="my-reports__link" href="{{ card.url }}"><span class="my-reports__key">{{ card.key }}</span> <span class="my-reports__title">{{ card.title }}</span></a>
                    {% if card.isStuck %}
                        <strong class="my-reports__side my-reports__side--stuck">{{ card.sideText }}</strong>
                    {% else %}
                        <span class="my-reports__side">{{ card.sideText }}</span>
                    {% endif %}
                </div>
                <twig:ProgressDots :labels="stageLabels" :current="card.stage.value" :isWaiting="card.isWaiting" class="my-reports__dots" />
                <div class="my-reports__bottom">
                    {% if card.avatarName is not null %}<twig:Avatar name="{{ card.avatarName }}" class="my-reports__avatar" />{% endif %}
                    <p class="my-reports__now">{{ card.nowText }}</p>
                    {% if card.pinProgressText is not null %}<span class="my-reports__pins">{{ card.pinProgressText }}</span>{% endif %}
                    {%- set menuId = 'my-reports-menu-' ~ card.key -%}
                    <div class="my-reports__actions">
                        {% if card.isAnswerOffered %}
                            <twig:Button size="sm" href="{{ card.url }}" class="my-reports__answer">Answer<span class="visually-hidden"> on {{ card.key }}</span></twig:Button>
                        {% elseif card.pingUserId is not null %}
                            {#- PingController::sheetFrameIdOf's id; the frame gets the opened sheet, or "Pinged · again in N h". -#}
                            {%- set pingFrameId = 'ping-sheet-' ~ card.key -%}
                            <form method="get" action="{{ path('notification_ping_sheet', {key: card.key, userId: card.pingUserId}) }}" class="my-reports__ping-form" data-turbo="true" data-turbo-frame="{{ pingFrameId }}">
                                <twig:Button type="submit" variant="{{ card.isStuck ? 'tonal' : 'text' }}" size="sm" class="my-reports__ping" aria-haspopup="dialog">Ping {{ card.pingFirstName }}<span class="visually-hidden"> about {{ card.key }}</span></twig:Button>
                            </form>
                            <turbo-frame id="{{ pingFrameId }}" class="my-reports__ping-frame"></turbo-frame>
                        {% endif %}
                        <div class="menu my-reports__menu" {{ stimulus_controller('menu') }} data-action="focusout->menu#closeOnFocusLeave">
                            <button type="button" class="icon-btn my-reports__menu-trigger" aria-label="More for {{ card.key }}" aria-haspopup="menu" aria-expanded="false" aria-controls="{{ menuId }}"
                                {{ stimulus_target('menu', 'trigger') }} data-action="menu#toggle keydown->menu#triggerKey click@window->menu#closeOnOutsideClick">⋯</button>
                            <div id="{{ menuId }}" class="menu__list" role="menu" aria-label="More for {{ card.key }}" hidden
                                {{ stimulus_target('menu', 'list') }} data-action="keydown->menu#navigate click->menu#closeOnSelect">
                                <a class="menu__item" role="menuitem" tabindex="-1" href="{{ card.url }}" {{ stimulus_target('menu', 'item') }}>Open ticket</a>
                                <a class="menu__item" role="menuitem" tabindex="-1" href="{{ card.url }}#thread-composer-body" {{ stimulus_target('menu', 'item') }}>Add more info</a>
                            </div>
                        </div>
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{% block main %}
    {%- set labels = {needs_you: 'Needs you', stuck: 'Stuck', moving: 'Moving'} -%}
    {%- set hints = {needs_you: 'Someone waits for your answer', stuck: 'No change for more than 7 days. A ping can help.', moving: 'Nothing to do. Just follow along.'} -%}
    <div class="my-reports">
        <header class="my-reports__header">
            <div class="my-reports__heading">
                <h1>My reports</h1>
                {% if totals is not null %}
                    <p class="my-reports__intro">
                        {{- totals.reportCount|number_format }} {{ totals.reportCount == 1 ? 'ticket' : 'tickets' }} you reported.
                        {% if totals.needsYouCount > 0 -%}
                            {{ totals.needsYouCount|number_format }} {{ totals.needsYouCount == 1 ? 'needs' : 'need' }} your answer.
                        {%- else -%}
                            None needs you right now.
                        {%- endif -%}
                    </p>
                {% endif %}
            </div>
            {#- The empty state has its own Report a problem button. -#}
            {% if hasReports %}
                <twig:Button href="{{ path('ticketing_report') }}" class="my-reports__report">Report a problem</twig:Button>
            {% endif %}
        </header>

        {% if not hasReports %}
            {% if isFirstPage %}
                <twig:EmptyState message="When you report a problem, you can follow it here until it is fixed.">
                    <twig:block name="action"><twig:Button variant="tonal" size="sm" href="{{ path('ticketing_report') }}" class="my-reports__report">Report a problem</twig:Button></twig:block>
                </twig:EmptyState>
            {% else %}
                <twig:EmptyState message="No more reports.">
                    <twig:block name="action"><twig:Button variant="text" size="sm" href="{{ firstPageUrl }}" class="my-reports__first-page">Back to your newest reports</twig:Button></twig:block>
                </twig:EmptyState>
            {% endif %}
        {% else %}
            {% for section in sections %}
                <section class="my-reports__group my-reports__group--{{ section.group }}" aria-labelledby="my-reports-{{ section.group }}">
                    <header class="my-reports__group-header">
                        <h2 id="my-reports-{{ section.group }}" class="my-reports__group-name">{{ labels[section.group] }} <span class="my-reports__count">{{ section.count|number_format }}</span></h2>
                        <p class="my-reports__hint">{{ hints[section.group] }}</p>
                    </header>
                    {{ _self.cards(section.shown, stageLabels) }}
                    {% if section.folded is not empty %}
                        {#- my-reports.css shows one of the two texts, by details[open]. -#}
                        <details class="my-reports__more">
                            <summary><span class="my-reports__when-closed">Show {{ section.folded|length|number_format }} more</span><span class="my-reports__when-open">Show fewer</span></summary>
                            {{ _self.cards(section.folded, stageLabels) }}
                        </details>
                    {% endif %}
                </section>
            {% endfor %}
            {% if doneCards is not empty %}
                <details class="my-reports__done">
                    <summary><span class="my-reports__when-closed">Show {{ doneCards|length|number_format }} done</span><span class="my-reports__when-open">Hide {{ doneCards|length|number_format }} done</span></summary>
                    {{ _self.cards(doneCards, stageLabels) }}
                </details>
            {% endif %}
        {% endif %}

        {% if nextPageUrl or (hasReports and not isFirstPage) %}
            <nav class="my-reports__pages" aria-label="Pages of reports">
                {% if hasReports and not isFirstPage %}
                    <twig:Button variant="text" size="sm" href="{{ firstPageUrl }}" class="my-reports__first-page">Back to your newest reports</twig:Button>
                {% endif %}
                {% if nextPageUrl %}
                    <twig:Button variant="text" size="sm" href="{{ nextPageUrl }}" class="my-reports__next-page">Show more</twig:Button>
                {% endif %}
            </nav>
        {% endif %}
    </div>
{% endblock %}
