{% extends '@Web/base.html.twig' %}

{% block title %}Choose a new password · pinround{% endblock %}

{# Logged out, like the login page: its card and stylesheet, no app header. #}
{% block site_header %}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}

{% block main %}
    <div class="login">
        <twig:Card tag="section" class="login__card" aria-labelledby="reset-title">
            <p class="logo">{{ block('logo', '@Web/base.html.twig') }}</p>
            <h1 class="login__title" id="reset-title">Choose a new password</h1>
            {% if linkProblem %}
                <p class="login__error" role="alert">{{ linkProblem }}</p>
                <p><a class="login__link" href="{{ path('identity_password_forgot') }}">Ask for a new link</a></p>
            {% else %}
                {% if errorMessage %}
                    <p class="login__error" role="alert">{{ errorMessage }}</p>
                {% endif %}
                <form class="login__form" method="post" action="{{ path('identity_password_reset') }}">
                    <label class="login__field">
                        New password
                        <input class="login__input" type="password" name="password" autocomplete="new-password" minlength="{{ minimumPasswordLength }}" required autofocus>
                    </label>
                    <label class="login__field">
                        Repeat the new password
                        <input class="login__input" type="password" name="password_repeat" autocomplete="new-password" minlength="{{ minimumPasswordLength }}" required>
                    </label>
                    <p class="login__hint">At least {{ minimumPasswordLength }} characters.</p>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_reset') }}">
                    <twig:Button type="submit">Save password</twig:Button>
                </form>
            {% endif %}
        </twig:Card>
    </div>
{% endblock %}
