{% extends '@Web/base.html.twig' %}

{% block title %}Forgot password · pinround{% endblock %}

{# Logged out, like the login page: its card and stylesheet, no app header. #}
{% block site_header %}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}

{% block main %}
    <div class="login">
        <twig:Card tag="section" class="login__card" aria-labelledby="forgot-title">
            <p class="logo">{{ block('logo', '@Web/base.html.twig') }}</p>
            <h1 class="login__title" id="forgot-title">Forgot password</h1>
            {% if notice %}
                <p class="login__notice" role="status">{{ notice }}</p>
            {% else %}
                {% if errorMessage %}
                    <p class="login__error" role="alert">{{ errorMessage }}</p>
                {% endif %}
                <p>Type the email you log in with. We send you a link to choose a new password.</p>
                <form class="login__form" method="post" action="{{ path('identity_password_forgot') }}">
                    <label class="login__field">
                        Email
                        <input class="login__input" type="email" name="email" autocomplete="username" required autofocus>
                    </label>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('password_forgot') }}">
                    <twig:Button type="submit">Send link</twig:Button>
                </form>
            {% endif %}
            <p><a class="login__link" href="{{ path('identity_login') }}">Back to log in</a></p>
        </twig:Card>
    </div>
{% endblock %}
