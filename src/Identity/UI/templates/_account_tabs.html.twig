{#- The tab rail between a person's own pages, which the avatar menu also lists, in the menu's order. current is the
    route of the page it sits on; every person may open all three, so the rail asks no voter. -#}
<nav aria-label="Your account">
    <twig:SegmentedControl label="Your account" :links="[
        {label: 'Profile', href: path('identity_profile'), isCurrent: current == 'identity_profile'},
        {label: 'Security', href: path('identity_security'), isCurrent: current == 'identity_security'},
        {label: 'API tokens', href: path('identity_tokens'), isCurrent: current == 'identity_tokens'},
    ]"/>
</nav>
