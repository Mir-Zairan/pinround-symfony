<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Identity\Domain\ApiToken" table="idn_api_token">
        <indexes>
            <index name="idn_api_token_user_id_created_at_idx" columns="organization_id,user_id,created_at"/>
            <!-- ApiTokens::livePage and claimExpiryWarnings, both ordered by expiry. -->
            <index name="idn_api_token_expires_at_id_live_idx" columns="organization_id,expires_at,id">
                <options>
                    <option name="where">(revoked_at IS NULL)</option>
                </options>
            </index>
        </indexes>
        <unique-constraints>
            <!-- For resolve_api_token, which runs before the tenant is known (data-model.md, the documented exception). -->
            <unique-constraint name="idn_api_token_token_hash_key" columns="token_hash"/>
        </unique-constraints>

        <id name="organizationId" type="guid" column="organization_id" position="0"/>
        <id name="id" type="guid" column="id" position="1"/>

        <field name="userId" type="guid" column="user_id"/>
        <field name="name" type="text" column="name"/>
        <field name="tokenHash" type="binary" column="token_hash"/>
        <field name="prefix" type="text" column="prefix"/>
        <field name="scopes" type="text_array" column="scopes"/>
        <field name="createdAt" type="datetimetz_immutable" column="created_at"/>
        <field name="expiresAt" type="datetimetz_immutable" column="expires_at"/>
        <field name="lastUsedAt" type="datetimetz_immutable" column="last_used_at" nullable="true"/>
        <field name="revokedAt" type="datetimetz_immutable" column="revoked_at" nullable="true"/>
        <field name="expiryWarnedAt" type="datetimetz_immutable" column="expiry_warned_at" nullable="true"/>
    </entity>
</doctrine-mapping>
