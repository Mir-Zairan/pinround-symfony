<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Organization\Domain\TeamMember" table="org_team_member">
        <indexes>
            <index name="org_team_member_organization_id_user_id_idx" columns="organization_id,user_id"/>
            <!-- The foreign key's index, which DBAL requires; no tenant query uses it (data-model.md, org_team_member). -->
            <index name="org_team_member_team_id_idx" columns="team_id"/>
        </indexes>

        <!-- Positions give the key order (organization_id, team_id, user_id); without them the association comes last. -->
        <id name="organizationId" type="guid" column="organization_id" position="0"/>
        <id name="team" association-key="true" position="1"/>
        <id name="userId" type="guid" column="user_id" position="2"/>

        <field name="teamRole" type="text" column="team_role" enum-type="App\Organization\Domain\TeamRole"/>
        <field name="job" type="text" column="job" enum-type="App\Organization\Domain\Job"/>
        <field name="createdAt" type="datetimetz_immutable" column="created_at"/>

        <many-to-one field="team" target-entity="App\Organization\Domain\Team" inversed-by="members">
            <join-column name="team_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
