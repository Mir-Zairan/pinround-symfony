{% extends '@Web/admin/layout.html.twig' %}

{% block title %}AI · Admin · pinround{% endblock %}

{# The form fields and errors of the logged-out pages and the profile page; admin-tab.css and admin-ai.css lay out this page. #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/profile.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/admin-tab.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/admin-ai.css') }}">
{% endblock %}

{#
    Each setting is a form of its own that applies at once (admin.md: no save button). A chip or switch posts the choice
    it stands for, not "toggle", so a second click of the same button changes nothing.
#}
{% block admin_tab %}
    {% set where_notes = {
        cloud: 'Every AI request goes to the company’s cloud AI. It costs money per use.',
        laptop: 'Free. Ticket text never leaves the laptop. People without Ollama get no AI features.',
        laptop_first: 'Free when Ollama runs. Otherwise pinround uses the cloud AI, so nobody is left without AI.',
    } %}
    <div class="admin-tab">
        <h1 class="admin-tab__title">AI</h1>
        <p>These settings change what the ticket page offers right now.</p>
        {% if formError %}
            <p class="login__error" role="alert">{{ formError }}</p>
        {% endif %}

        <twig:Card tag="section" class="admin-ai__card" aria-label="AI help">
            {% import '@Organization/admin/_ai_setting_controls.html.twig' as ai_settings %}
            {{ ai_settings.switch_row('on', 'AI help (summaries, “Explain it to me”, checking new tickets)', chosen.on) }}
            {{ ai_settings.chip_group('who', 'Who may use it', {everyone: 'Everyone', leads_only: 'Leads only'}, chosen.who) }}
            {{ ai_settings.chip_group('send', 'What goes to the AI', {title_and_text: 'Title and ticket text', title_only: 'Title only'}, chosen.send) }}
            {{ ai_settings.switch_row('sync', 'Write a summary for every ticket when it syncs from Jira', chosen.sync) }}
            {{ ai_settings.chip_group('where', 'Where the AI runs', {cloud: 'Company cloud AI', laptop: 'Each person’s laptop (Ollama)', laptop_first: 'Laptop first, cloud when it is off'}, chosen.where) }}
            <p class="admin-ai__note admin-ai__where-note">{{ where_notes[chosen.where] }}</p>
            {{ ai_settings.switch_row('restricted_to_cloud', 'Send team-only tickets to the cloud AI too', chosen.restricted_to_cloud) }}
            <p class="admin-ai__note">When this is off, tickets that only their team can see never go to the cloud AI.</p>
        </twig:Card>

        <twig:Card tag="section" class="admin-ai__card" aria-labelledby="admin-ai-provider-title">
            {% import '@Organization/admin/_ai_setting_controls.html.twig' as ai_settings %}
            <h2 class="admin-tab__heading" id="admin-ai-provider-title">Cloud AI</h2>
            {{ ai_settings.chip_group('provider', 'Provider', {huggingface: 'Hugging Face', anthropic: 'Anthropic (Claude)', ollama: 'Ollama server'}, chosen.provider) }}
            <form class="admin-tab__inline-form" method="post" action="{{ path('organization_admin_ai_provider_key') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('organization_admin_ai_provider_key') }}">
                <div class="profile__field admin-tab__field">
                    <label class="login__field">
                        API key
                        {# Never filled in: the saved key is not shown again, and a refused one is typed again. #}
                        <input class="login__input" type="password" name="provider_key" value="" maxlength="{{ providerKeyMaxLength }}" autocomplete="new-password" required
                            {%- if providerKeyError %} aria-invalid="true" aria-describedby="admin-ai-key-error admin-ai-key-status"{% else %} aria-describedby="admin-ai-key-status"{% endif %}>
                    </label>
                    {% if providerKeyError %}
                        <p class="profile__error" id="admin-ai-key-error">{{ providerKeyError }}</p>
                    {% endif %}
                    <p class="admin-ai__note" id="admin-ai-key-status">
                        {%- if hasProviderKey -%}
                            A key is saved. A new key replaces it.
                        {%- else -%}
                            No key saved. pinround uses its own key.
                        {%- endif -%}
                    </p>
                </div>
                <twig:Button type="submit">Save key</twig:Button>
            </form>
            <p class="admin-ai__note">Before the key is saved, you may need to confirm it’s you with your password and a code.</p>
        </twig:Card>

        <twig:Card tag="section" class="admin-ai__card" aria-labelledby="admin-ai-model-title">
            <h2 class="admin-tab__heading" id="admin-ai-model-title">Model for laptops</h2>
            <p><span class="mono">qwen3:4b</span> · about 2.5 GB · runs on the processor, no graphics card needed · good at returning the JSON pinround asks for.</p>
            <p class="admin-ai__note">Lighter: <span class="mono">phi4-mini</span>. Test both on your slowest laptop before you choose.</p>
        </twig:Card>

        <p class="admin-ai__footnote">pinround uses Symfony AI: the Ollama bridge for laptops, and a cloud bridge (Claude or Hugging Face) for the rest.</p>
    </div>
{% endblock %}
