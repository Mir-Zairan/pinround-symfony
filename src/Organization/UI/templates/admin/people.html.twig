{% extends '@Web/admin/layout.html.twig' %}

{% block title %}People and roles · pinround{% endblock %}

{# The form fields and errors of the logged-out pages and the profile page; admin-tab.css and people.css lay out this page. #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/profile.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/admin-tab.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/people.css') }}">
{% endblock %}

{# TODO(P11): the role help cards, and changing roles in the list of people (P11.T2). #}
{% block admin_tab %}
    {% set teamRoleNames = {lead: 'Team lead', member: 'Team member', viewer: 'Team viewer'} %}
    {# The job "other" says nothing, so it is left out of the line. #}
    {% set jobNames = {developer: 'Developer', tester: 'Tester'} %}
    <div class="admin-tab">
        <h1 class="admin-tab__title">People and roles</h1>
        <p>A role says what someone may do. The job (tester, developer) is set by the team lead.</p>
        {% if formError %}
            <p class="login__error" role="alert">{{ formError }}</p>
        {% endif %}

        <twig:Card tag="section" aria-labelledby="people-invite-title">
            <h2 class="admin-tab__heading" id="people-invite-title">Invite</h2>
            <form class="admin-tab__inline-form" method="post" action="{{ path('organization_admin_people_invite') }}" {{ stimulus_controller('invite-email') }}>
                <div class="profile__field admin-tab__field">
                    <label class="login__field">
                        Email
                        <input class="login__input" type="email" name="email" value="{{ typedEmail }}" placeholder="name@company.com" autocomplete="off" required
                            {{ stimulus_target('invite-email', 'field') }} data-action="input->invite-email#update"
                            {%- if emailError %} aria-invalid="true" aria-describedby="people-email-error"{% endif %}>
                    </label>
                    {% if emailError %}
                        <p class="profile__error" id="people-email-error">{{ emailError }}</p>
                    {% endif %}
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('organization_admin_people_invite') }}">
                <twig:Button type="submit" data-invite-email-target="submit">Invite</twig:Button>
            </form>
        </twig:Card>

        <section class="people__members" aria-labelledby="people-members-title">
            <h2 class="admin-tab__heading" id="people-members-title">People</h2>
            {% if people is empty and peopleFirstPage is not null %}
                {# A later page of a list can be empty, as when the last ones left after the page before was shown. #}
                <p class="people__sub">No more people. <a href="{{ path('organization_admin_people', peopleFirstPage) }}">Back to the first page</a></p>
            {% elseif people is empty %}
                <twig:EmptyState message="No one has joined yet."/>
            {% else %}
                <ul class="people__list">
                    {% for person in people %}
                        <li class="people__row people__person" data-user-id="{{ person.userId.toString }}">
                            <div class="people__person-head">
                                <twig:Avatar name="{{ person.displayName }}" aria-hidden="true"/>
                                <span class="people__name">{{ person.displayName }}</span>
                                {% if person.isAdmin %}<twig:Tag>Admin</twig:Tag>{% endif %}
                                {% if person.isManager %}<twig:Tag>Manager</twig:Tag>{% endif %}
                            </div>
                            {% if person.teams is empty %}
                                <span class="people__sub">No team yet</span>
                            {% else %}
                                <ul class="people__teams">
                                    {% for team in person.teams %}
                                        {% set job = jobNames[team.job.value] ?? null %}
                                        <li class="people__sub">{{ job ? job ~ ' · ' }}{{ team.teamName }} · {{ teamRoleNames[team.teamRole.value] }}</li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                {% if peopleNextPage %}
                    <div class="people__more">
                        <twig:Button href="{{ path('organization_admin_people', peopleNextPage) }}" variant="outline">Show more</twig:Button>
                    </div>
                {% endif %}
            {% endif %}
        </section>

        <section class="people__pending" aria-labelledby="people-pending-title">
            <h2 class="admin-tab__heading" id="people-pending-title">Not joined yet</h2>
            {% if pendingInvitations is empty and invitationsFirstPage is not null %}
                <p class="people__sub">No more invites. <a href="{{ path('organization_admin_people', invitationsFirstPage) }}">Back to the first page</a></p>
            {% elseif pendingInvitations is empty %}
                <twig:EmptyState message="No open invites."/>
            {% else %}
                <ul class="people__list">
                    {% for invitation in pendingInvitations %}
                        <li class="people__row">
                            <span class="people__email-address">{{ invitation.email }}</span>
                            <span class="people__sub">Invited · not joined yet</span>
                        </li>
                    {% endfor %}
                </ul>
                {% if nextPage %}
                    <div class="people__more">
                        <twig:Button href="{{ path('organization_admin_people', nextPage) }}" variant="outline">Show more</twig:Button>
                    </div>
                {% endif %}
            {% endif %}
        </section>

        <section class="people__tokens" aria-labelledby="people-tokens-title">
            <h2 class="admin-tab__heading" id="people-tokens-title">API tokens</h2>
            <p>Tokens that work now, the first to stop working at the top. Revoke one to stop it at once.</p>
            {% if liveTokens is empty and tokensFirstPage is not null %}
                <p class="people__sub">No more tokens. <a href="{{ path('organization_admin_people', tokensFirstPage) }}">Back to the first page</a></p>
            {% elseif liveTokens is empty %}
                <twig:EmptyState message="No API tokens work now."/>
            {% else %}
                <ul class="people__list">
                    {% for token in liveTokens %}
                        {% set ownerName = tokenOwnerNames[token.ownerId.toString] ?? 'Unknown person' %}
                        <li class="people__row people__token-row" data-token-id="{{ token.id }}">
                            <span class="people__token-owner">{{ ownerName }}</span>
                            <span class="people__sub">
                                {{ token.name }} · <code>{{ token.prefix }}…</code>
                                · Works until {{ token.expiresAt|date('j M Y', app.user.timeZone) }}
                            </span>
                            {# The pages both lists are on, so the revoke comes back to them. #}
                            <form class="people__revoke" method="post" action="{{ path('organization_admin_people_token_revoke', {id: token.id}) }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token(revokeTokenCsrfId) }}">
                                {% for name, value in shownPagesQuery %}
                                    <input type="hidden" name="{{ name }}" value="{{ value }}">
                                {% endfor %}
                                <twig:Button type="submit" variant="outline" aria-label="Revoke {{ ownerName }}’s token {{ token.name }}, {{ token.prefix }}…">Revoke</twig:Button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
                {% if tokensNextPage %}
                    <div class="people__more">
                        <twig:Button href="{{ path('organization_admin_people', tokensNextPage) }}" variant="outline">Show more</twig:Button>
                    </div>
                {% endif %}
            {% endif %}
        </section>
    </div>
{% endblock %}
