{#- VerdictController's answer to a Turbo form: each area's state tag in the strip and the side panel as they are now, then
    the toast. The panel's focusedControlId control has autofocus, which Turbo focuses after the swap, as the clicked button
    went with the old panel. -#}
{% for tab in tabs %}
    {% set tagId = constant('App\\Review\\UI\\RoundPage\\RoundPages::AREA_STATE_ID_PREFIX') ~ tab.position %}
    <turbo-stream action="replace" target="{{ tagId }}"><template>{{ include('@Review/_screenshot_thumb_tag.html.twig', {tagLabel: tab.stateLabel, tagClass: tab.stateClass, tagId: tagId}, with_context = false) }}</template></turbo-stream>
{% endfor %}
<turbo-stream action="replace" target="round-panel"><template>{{ include('@Review/_round_panel.html.twig') }}</template></turbo-stream>
{{ include('@Web/_toast_stream.html.twig', {message: toast}) }}
