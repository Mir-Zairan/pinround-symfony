{% extends '@Web/base.html.twig' %}

{#- One of the person's report drafts (ReportDraftController::page): edit the text, then in the ScreenshotEditor, one
    picture at a time, each picture's title, summary and pin notes, or remove it; then Report a problem's "Where it goes"
    and its "When you send:" words; then Send (makes the ticket with Round 0) or Delete. Pins keep their spots here. -#}

{% block title %}{{ draft.title }} · Report draft · pinround{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/review.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/screenshot-editor.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/profile.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/report.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/report-drafts.css') }}">
{% endblock %}

{% block main %}
    <div class="report-draft">
        <twig:Button variant="text" href="{{ path('review_report_drafts') }}" class="report-draft__back"><span aria-hidden="true">&lt;</span> Report drafts</twig:Button>
        <h1 class="report-draft__title">Report draft for {{ draft.projectKey }}</h1>
        <p class="report-draft__hint">Only you see this draft. Nothing reaches the team until you press Send.</p>
        {% if error %}
            <p class="report-draft__error" role="alert" id="report-draft-error">{{ error }}</p>
        {% endif %}

        <form class="report-draft__form" method="post" action="{{ path('review_report_draft_save', {id: draft.id}) }}" {% if error %}aria-describedby="report-draft-error"{% endif %}
            data-controller="report-form"
            data-report-form-preview-url-value="{{ path('review_report_draft_preview', {id: draft.id}) }}"
            data-action="input->report-form#schedulePreview change->report-form#schedulePreview">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrfId) }}">
            <input type="hidden" name="version" value="{{ draft.version }}">
            <label class="form-field">
                What is wrong, in one line
                <input class="form-field__input" type="text" name="title" value="{{ title }}" maxlength="200" required>
            </label>
            <label class="form-field">
                More detail · optional
                <textarea class="form-field__input" name="detail" rows="5">{{ detail }}</textarea>
            </label>

            {% if screenshots is not empty %}
                <twig:ScreenshotEditor :screenshots="screenshots" fieldId="draft-shots" :canAdd="false" />
            {% endif %}

            {#- Ticketing's "Where it goes" by its component name; only Send reads it, a draft does not keep it. -#}
            {{ component('WhereItGoesFields', {organizationId: reporter.organizationId, reporterId: reporter.userId, input: whereItGoes}) }}
            <p class="report__preview" role="status" aria-live="polite"{% if preview == '' %} hidden{% endif %} data-report-form-target="previewLine"><strong>When you send:</strong> <span data-report-form-target="preview">{{ preview }}</span></p>

            {#- Save changes comes first, so Enter in a field saves rather than sends. Send saves what is typed, then sends it. -#}
            <p class="report-draft__actions">
                <twig:Button type="submit" variant="outline">Save changes</twig:Button>
                <twig:Button type="submit" formaction="{{ path('review_report_draft_send', {id: draft.id}) }}">Send</twig:Button>
            </p>
        </form>

        <div class="report-draft__actions">
            <form method="post" action="{{ path('review_report_draft_delete', {id: draft.id}) }}" data-turbo-confirm="Delete this report draft? This cannot be undone.">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrfId) }}">
                <twig:Button type="submit" variant="text">Delete draft</twig:Button>
            </form>
        </div>
    </div>
{% endblock %}
