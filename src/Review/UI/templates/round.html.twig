{% extends '@Web/base.html.twig' %}

{#- One round of a ticket (RoundController), laid out as the prototype's Review board: a sticky header, a tab per
    screenshot when there are two or more, the Before and After side by side with numbered markers, and the side panel
    with each picture's pins. The tabs are links ("?area=N" for a screen area, "?screenshot=N" otherwise), so they work
    without JavaScript; screenshot-pager adds the arrow keys, round-pins ties each marker to its row in the panel, and
    only the compare control needs the compare Stimulus controller, staying hidden without it. -#}

{% block title %}Round {{ roundNumber }} · {{ page.ticketKey }} · pinround{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/review.css') }}">
{% endblock %}

{% block main %}
    {% set shown = page.shown %}
    {% set roundPath = {key: page.ticketKey, number: roundNumber} %}
    {% set ticketHref = path(ticketRoute, {key: page.ticketKey}) %}
    {% set hasTabs = page.tabs|length > 1 %}
    {#- The fragment an arrow key's visit carries; no element has it as id, so the browser does not scroll. -#}
    {% set shownTabFragment = 'shown-tab' %}
    <article class="round-page" data-controller="compare screenshot-pager round-pins" data-compare-mode="both" data-screenshot-pager-fragment-value="{{ shownTabFragment }}" data-action="keydown@document->screenshot-pager#follow click->round-pins#select">
        <header class="round-page__header">
            <div class="round-page__bar">
                <a href="{{ ticketHref }}" class="icon-btn round-page__back" aria-label="Back to {{ page.ticketKey }}">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                </a>
                <div class="round-page__heading">
                    <p class="round-page__ticket"><span class="round-page__key">{{ page.ticketKey }}</span> · <a href="{{ ticketHref }}" class="round-page__ticket-link">{{ page.ticketTitle }}</a></p>
                    <h1 class="round-page__title">{{ page.title }}<span class="round-page__detail"> · {{ page.detail }}</span></h1>
                </div>
                {% if shown is not null %}
                    {% if shown.before is not null %}
                        <twig:SegmentedControl label="Compare" :options="{both: 'Side by side', before: 'Before', after: 'After'}" selected="both" class="round-compare-control" hidden data-compare-target="control" data-action="click->compare#choose" />
                    {% endif %}
                    <twig:Button variant="outline" href="{{ path(focusRoute, roundPath|merge(page.shownParameters)) }}" id="{{ fullScreenControlId }}" class="round-page__full-screen" data-controller="fragment-focus">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
                        Full screen
                    </twig:Button>
                {% endif %}
            </div>
            {% if hasTabs %}
                {#- Page links styled as tabs, not ARIA tabs: each one loads another page, which a tab must not do. -#}
                <nav class="round-tabs" aria-label="{{ page.tabsLabel }}">
                    {% for tab in page.tabs %}
                        {% set pagerTarget = page.pagerTargetOf(tab) %}
                        <a class="round-tab" id="{{ tab.elementId }}" href="{{ path(roundRoute, roundPath|merge(tab.parameters)) }}"
                            {%- if tab.isShown %} aria-current="page" data-controller="fragment-focus" data-fragment-focus-fragment-value="{{ shownTabFragment }}"{% endif %}
                            {%- if pagerTarget is not null %} data-screenshot-pager-target="{{ pagerTarget }}"{% endif %}>
                            <span class="round-tab__label">{{ tab.label }}</span>
                            {{ include('@Review/_screenshot_tab_tag.html.twig', {tagLabel: tab.tagLabel, tagClass: tab.tagClass, tagId: tab.tagId}, with_context = false) }}
                        </a>
                    {% endfor %}
                </nav>
            {% endif %}
        </header>

        {% if shown is null %}
            <twig:EmptyState message="{{ page.emptyMessage }}" />
            {% if moveOnForm is not null %}
                <twig:MoveOnButtons :form="moveOnForm" :roundNumber="roundNumber" />
            {% endif %}
        {% else %}
            <div class="round-page__body">
                <section class="round-compare" aria-label="Pictures of {{ shown.name }}">
                    <div class="round-compare__sides">
                        {% if shown.before is not null %}
                            {{ include('@Review/_round_compare_side.html.twig', {side: 'before', caption: shown.beforeCaption, view: shown.before}, with_context = false) }}
                        {% endif %}
                        {{ include('@Review/_round_compare_side.html.twig', {side: 'after', caption: shown.afterCaption, view: shown.after}, with_context = false) }}
                    </div>
                    {% if shown.after.pins is not empty or (shown.before is not null and shown.before.pins is not empty) %}
                        <p class="round-compare__hint">Click a pin to see its note in the list.</p>
                    {% endif %}
                </section>

                <div class="round-page__side">
                    {% if copyToDraft is not null %}
                        {{ include('@Review/_copy_to_draft_form.html.twig', {ticketKey: page.ticketKey, source: copyToDraft, csrfId: draftCsrfId, formClass: 'round-page__copy-to-draft', size: 'md'}, with_context = false) }}
                    {% endif %}
                    {% if page.panel is not null %}
                        {{ include('@Review/_round_panel.html.twig', {panel: page.panel}) }}
                    {% elseif page.screenshotPanel is not null %}
                        {{ include('@Review/_round_screenshot_panel.html.twig', {panel: page.screenshotPanel}) }}
                    {% endif %}
                    {% if moveOnForm is not null %}
                        <twig:MoveOnButtons :form="moveOnForm" :roundNumber="roundNumber" />
                    {% elseif page.panel is null and page.verdictGiverName is not null %}
                        <section class="round-verdict-giver" aria-labelledby="round-verdict-giver">
                            <h2 class="round-verdict-giver__label" id="round-verdict-giver">Verdict</h2>
                            <p class="round-verdict-giver__sentence">{{ page.verdictGiverName }} gives the verdict by moving {{ page.ticketKey }} on.</p>
                        </section>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </article>
{% endblock %}
