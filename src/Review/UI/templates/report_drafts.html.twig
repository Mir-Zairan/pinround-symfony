{% extends '@Web/base.html.twig' %}

{#- The person's own report drafts (ReportDraftController::list), newest change first, a page at a time; "Show more"
    opens the next page. Nobody else ever sees this list. -#}

{% block title %}Report drafts · pinround{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/security.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/report-drafts.css') }}">
{% endblock %}

{% block main %}
    <div class="security report-drafts">
        <h1 class="security__title">Report drafts</h1>
        <p class="login__hint">Claude Code and the browser extension can prepare a report for you. It waits here until you check it and send it, which makes the ticket. Only you see it.</p>
        <p><twig:Button variant="text" href="{{ path('review_notebooks') }}">My notebooks</twig:Button></p>
        {% if drafts is empty and isLaterPage %}
            <twig:EmptyState message="No more report drafts." />
        {% elseif drafts is empty %}
            <twig:EmptyState message="You have no report drafts yet. To make one, pick “A new report” in the browser extension, or ask Claude Code to report a problem. Both need an API token that may prepare report drafts.">
                <twig:block name="action"><twig:Button variant="tonal" size="sm" href="{{ path('identity_tokens') }}">Make an API token</twig:Button></twig:block>
            </twig:EmptyState>
        {% else %}
            <ul class="report-drafts__list">
                {% for draft in drafts %}
                    <li class="report-drafts__item">
                        <twig:Card tag="article" class="report-drafts__card" aria-labelledby="report-draft-{{ loop.index }}">
                            <h2 class="security__heading" id="report-draft-{{ loop.index }}"><a href="{{ path('review_report_draft', {id: draft.id}) }}">{{ draft.title }}</a></h2>
                            <p class="login__hint">{{ draft.projectKey }} · {{ draft.screenshotCount }} {{ draft.screenshotCount == 1 ? 'screenshot' : 'screenshots' }}</p>
                        </twig:Card>
                    </li>
                {% endfor %}
            </ul>
            {% if nextAfter %}
                <p><twig:Button variant="outline" href="{{ path('review_report_drafts', {after: nextAfter}) }}" rel="next">Show more</twig:Button></p>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
