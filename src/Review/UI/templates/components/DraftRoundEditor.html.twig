{#- The owner's private draft on its page (DraftRoundEditor, a live component), laid out as a round page: the header with
    the status line, the draft's buttons and a tab per screenshot, then the shown screenshot (the Before beside it when
    there is one) with its verdict, pins, texts and Remove, and "Add screenshot"; a retaken screenshot with its try
    switch, an earlier try read-only but for its pin marks. Each change is one live action. The upload block and the pin
    placer of a ready picture are data-live-ignore: the browser owns them, so a re-render never wipes an upload's progress
    or a pin being moved. Both keep a stable id, so the live morph matches them to the next render's instead of adding a
    second one beside the one it may not remove. The pin placer is display: contents, so its picture and its pins sit in
    the board's grid apart from the verdict and texts it must not hold, which every re-render updates. -#}
{% set card = this.draftCard %}
<div{{ attributes.defaults({class: 'draft-round-editor'}) }}>
    {% if card is not null %}
        {% set editorId = card.domId ~ '-editor' %}
        {% set shownChain = this.shownScreenshot %}
        {% set before = shownChain is null ? null : this.before %}
        {#- Each picture says it is this draft's once the ticket has a round before it; a caption that followed the tab
            shown would not change inside the pin placer the morph leaves alone. -#}
        {% set hasRoundBefore = shownChain is not null and this.beforeCaption is not null %}
        {% set ticketHref = path(constant('App\\Review\\UI\\RoundsController::TICKET_ROUTE'), {key: this.ticketKey}) %}
        {% set csrfField = constant('App\\Review\\UI\\DraftRoundController::CSRF_FIELD') %}
        {% set draftCsrfToken = csrf_token(this.draftCsrfId) %}
        <header class="round-page__header draft-page__header">
            <div class="round-page__bar">
                <a href="{{ ticketHref }}" class="icon-btn round-page__back" aria-label="Back to {{ this.ticketKey }}">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
                </a>
                <div class="round-page__heading">
                    <p class="round-page__ticket"><span class="round-page__key">{{ this.ticketKey }}</span> · <a href="{{ ticketHref }}" class="round-page__ticket-link">{{ this.ticketTitle }}</a></p>
                    {#- A draft shared in another tab keeps its page until the next load, under its round's headline. -#}
                    <h1 class="round-page__title" id="{{ card.domId }}-heading">{{ card.isPrivateDraft ? constant('App\\Review\\UI\\Component\\DraftRoundEditor::PAGE_TITLE') : card.headline }}</h1>
                    <p class="draft-page__status">
                        {% if card.isPrivateDraft %}
                            <twig:Tag class="round-card__private">PRIVATE</twig:Tag>
                            <span>Only you can see this</span>
                        {% endif %}
                        {% if card.status is not null %}<span data-draft-status>{{ card.status }}</span>{% endif %}
                    </p>
                </div>
                {% if before is not null %}
                    <div class="seg-group round-compare-control" role="group" aria-label="Compare">
                        {%- for mode, modeLabel in {(constant('App\\Review\\UI\\Component\\DraftRoundEditor::COMPARE_BOTH')): 'Side by side', (constant('App\\Review\\UI\\Component\\DraftRoundEditor::COMPARE_BEFORE')): 'Before', (constant('App\\Review\\UI\\Component\\DraftRoundEditor::COMPARE_AFTER')): 'After'} -%}
                            <button type="button" class="seg" aria-pressed="{{ mode is same as(this.compareMode) ? 'true' : 'false' }}" data-action="live#action" data-live-action-param="compare" data-live-mode-param="{{ mode }}">{{ modeLabel }}</button>
                        {%- endfor -%}
                    </div>
                {% endif %}
                <div class="draft-page__actions">
                    <form method="post" action="{{ path(constant('App\\Review\\UI\\DraftRoundController::SHARE_ROUTE'), {key: this.ticketKey, id: card.roundId}) }}" class="round-card__form">
                        <input type="hidden" name="{{ csrfField }}" value="{{ draftCsrfToken }}">
                        <twig:Button type="submit" size="sm" class="round-card__share">Share with the team now</twig:Button>
                    </form>
                    <form method="post" action="{{ path(constant('App\\Review\\UI\\DraftRoundController::NEW_TICKET_ROUTE'), {key: this.ticketKey, id: card.roundId}) }}" class="round-card__form">
                        <input type="hidden" name="{{ csrfField }}" value="{{ draftCsrfToken }}">
                        <twig:Button type="submit" variant="outline" size="sm" class="round-card__new-ticket">Make it a new ticket</twig:Button>
                    </form>
                    <form method="post" action="{{ path(constant('App\\Review\\UI\\DraftRoundController::DELETE_ROUTE'), {key: this.ticketKey, id: card.roundId}) }}" class="round-card__form" data-turbo-confirm="{{ constant('App\\Review\\UI\\RoundCards::DELETE_DRAFT_CONFIRM') }}">
                        <input type="hidden" name="{{ csrfField }}" value="{{ draftCsrfToken }}">
                        <twig:Button type="submit" variant="text" size="sm" class="round-card__delete">Delete draft</twig:Button>
                    </form>
                </div>
            </div>
            {% if card.screenshots|length > 1 %}
                <div class="round-tabs" role="group" aria-label="Screenshots of the draft">
                    {% for tab in card.screenshots %}
                        <button type="button" class="round-tab" aria-pressed="{{ loop.index is same as(this.shownPosition) ? 'true' : 'false' }}" data-tab-screenshot-id="{{ tab.screenshotId }}"
                            data-action="live#action" data-live-action-param="showScreenshot" data-live-number-param="{{ loop.index }}">
                            <span class="round-tab__label">{{ tab.view.title ?? tab.label }}</span>
                            <twig:Tag class="round-tab__tag verdict-tag {{ tab.verdictClass }}">{{ tab.verdictLabel }}</twig:Tag>
                        </button>
                    {% endfor %}
                </div>
            {% endif %}
        </header>
        {% if card.description is not null %}<p class="draft-page__description">{{ card.description }}</p>{% endif %}

        <div class="draft-round-editor__body" id="{{ editorId }}"
            data-controller="draft-round-editor presigned-upload"
            data-draft-round-editor-presigned-upload-outlet="#{{ editorId }}"
            data-presigned-upload-url-value="{{ path('media_upload_intent_begin') }}"
            data-presigned-upload-status-url-value="{{ path('media_upload_status', {id: 'MEDIA_ID'}) }}"
            data-presigned-upload-csrf-token-value="{{ csrf_token('media_upload') }}"
            data-presigned-upload-target-kind-value="{{ this.uploadTargetKind }}"
            data-presigned-upload-target-id-value="{{ card.roundId }}"
            data-action="paste->presigned-upload#paste dragover->presigned-upload#dragOver drop->presigned-upload#drop presigned-upload:ready->draft-round-editor#addUploaded presigned-upload:still-processing->draft-round-editor#keepWaiting presigned-upload:started->draft-round-editor#resetWaiting pin-placer:change->draft-round-editor#schedulePinSave"
        >
            {% if this.refusal is not null %}
                <p class="draft-round-editor__refusal" role="alert" data-draft-round-editor-target="refusal">{{ this.refusal }}</p>
            {% endif %}
            {% if shownChain is null %}
                <p class="round-card__empty">{{ constant('App\\Review\\UI\\Component\\DraftRoundEditor::EMPTY_NOTE') }}</p>
            {% endif %}

            <div class="draft-board{% if shownChain is null %} draft-board--empty{% elseif before is not null %} draft-board--compare{% endif %}" data-compare-mode="{{ before is null ? constant('App\\Review\\UI\\Component\\DraftRoundEditor::COMPARE_AFTER') : this.compareMode }}">
                {% for chain in card.screenshots %}
                    {#- Every screenshot has its section, and only the chosen tab's is shown, so a tab switch keeps the pins
                        being placed on another. item is the try shown: the latest unless the owner switched to an earlier
                        one. The section's id names the try shown, so a try switch replaces the section whole: the live
                        morph never removes the data-live-ignore pin placer of a section it keeps. -#}
                    {% set item = this.shownTryOf(chain) %}
                    {% set isShown = loop.index is same as(this.shownPosition) %}
                    <section class="draft-shot" id="{{ item.view.domId }}-editor" data-screenshot-id="{{ item.screenshotId }}" aria-label="{{ item.label }}"{% if not isShown %} hidden{% endif %}>
                        {% if isShown and before is not null %}
                            <div class="draft-board__picture draft-board__picture--before">
                                <p class="round-compare__caption">{{ this.beforeCaption }}</p>
                                <twig:Screenshot :view="before" :showsText="false" class="screenshot--markers round-compare__picture" loading="lazy" />
                            </div>
                        {% endif %}
                        <section class="draft-board__verdict" aria-labelledby="{{ item.view.domId }}-verdict-heading">
                            <h2 class="round-panel__title round-card__screenshot-label" id="{{ item.view.domId }}-verdict-heading">
                                <span>{{ item.label }}</span>
                                {% if item.tryLabel is not null %}<span data-try-label>{{ item.tryLabel }}</span>{% endif %}
                                <twig:Tag class="verdict-tag {{ item.verdictClass }}">{{ item.verdictLabel }}</twig:Tag>
                            </h2>
                            {% if chain.tryCount > 1 %}
                                <div class="draft-shot__verdict" role="group" aria-label="Tries of {{ chain.label }}" data-try-switch>
                                    {% for try in chain.tries %}
                                        <twig:Chip :pressed="try.screenshotId is same as(item.screenshotId)" data-action="live#action" data-live-action-param="showTry" data-live-screenshot-id-param="{{ try.screenshotId }}">Try {{ try.tryNumber }}</twig:Chip>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            {% if item.isLatestTry %}
                                <div class="draft-shot__verdict" role="group" aria-label="Verdict for {{ item.label }}">
                                    {% set looksRight = constant('App\\Review\\Api\\RoundCommands::VERDICT_LOOKS_RIGHT') %}
                                    {% set notRightYet = constant('App\\Review\\Api\\RoundCommands::VERDICT_NOT_RIGHT_YET') %}
                                    <twig:Chip :pressed="item.looksRight" data-action="live#action" data-live-action-param="setVerdict" data-live-screenshot-id-param="{{ item.screenshotId }}" data-live-verdict-param="{{ item.looksRight ? '' : looksRight }}">Looks right</twig:Chip>
                                    <twig:Chip :pressed="item.isNotRightYet" data-action="live#action" data-live-action-param="setVerdict" data-live-screenshot-id-param="{{ item.screenshotId }}" data-live-verdict-param="{{ item.isNotRightYet ? '' : notRightYet }}">Not right yet</twig:Chip>
                                </div>
                            {% endif %}
                        </section>

                        {% if not item.isLatestTry %}
                            <div class="draft-board__picture draft-board__picture--after">
                                {% if hasRoundBefore %}<p class="round-compare__caption">After · this draft</p>{% endif %}
                                <twig:Screenshot :view="item.view" :showsText="false" class="screenshot--markers round-compare__picture" loading="lazy" />
                            </div>
                            <section class="draft-board__pins" aria-labelledby="{{ item.view.domId }}-pins-heading">
                                <h2 class="round-panel__title" id="{{ item.view.domId }}-pins-heading">Pins of try {{ item.tryNumber }}</h2>
                                {% if item.pinRows is empty %}
                                    <p class="round-card__empty">This try has no pins.</p>
                                {% else %}
                                    {% set fixed = constant('App\\Review\\Api\\VerdictCommands::PIN_FIXED') %}
                                    {% set stillWrong = constant('App\\Review\\Api\\VerdictCommands::PIN_STILL_WRONG') %}
                                    <ol class="round-panel__pins" aria-label="Pins of try {{ item.tryNumber }}">
                                        {% for row in item.pinRows %}
                                            {% set noteId = item.view.domId ~ '-pin-' ~ row.id %}
                                            <li class="round-panel__pin" value="{{ row.number }}" data-pin-id="{{ row.id }}">
                                                <span class="pin-list__number">{{ row.number }}</span>
                                                <p class="round-panel__note" id="{{ noteId }}">{% if row.note|trim is same as('') %}(no note){% else %}{{ row.note }}{% endif %}</p>
                                                <twig:Tag class="verdict-tag {{ row.verdictClass }}">{{ row.verdictLabel }}</twig:Tag>
                                                <div class="round-panel__pin-form" role="group" aria-label="Mark pin {{ row.number }}">
                                                    <twig:Chip :pressed="item.isPinFixed(row)" aria-describedby="{{ noteId }}" data-action="live#action" data-live-action-param="setPinVerdict" data-live-pin-id-param="{{ row.id }}" data-live-verdict-param="{{ item.isPinFixed(row) ? '' : fixed }}">{{ item.pinFixedLabel(row) }}</twig:Chip>
                                                    <twig:Chip :pressed="item.isPinStillWrong(row)" aria-describedby="{{ noteId }}" data-action="live#action" data-live-action-param="setPinVerdict" data-live-pin-id-param="{{ row.id }}" data-live-verdict-param="{{ item.isPinStillWrong(row) ? '' : stillWrong }}">{{ constant('App\\Review\\UI\\RoundCardScreenshot::PIN_STILL_WRONG') }}</twig:Chip>
                                                </div>
                                            </li>
                                        {% endfor %}
                                    </ol>
                                {% endif %}
                            </section>
                            <div class="draft-shot__actions draft-board__remove">
                                <button type="button" class="btn btn-text btn-sm draft-shot__remove"
                                    data-action="live#action" data-live-action-param="removeScreenshot" data-live-screenshot-id-param="{{ item.screenshotId }}">Remove this try</button>
                            </div>
                        {% else %}
                            <div class="pin-placer draft-board__placer" id="{{ item.view.domId }}-placer"{% if item.view.isReady %} data-live-ignore{% endif %}
                                data-controller="pin-placer"
                                data-pin-placer-note-max-value="{{ this.noteMaxLength }}"
                                data-pin-placer-note-placeholder-value="{{ constant('App\\Review\\UI\\Component\\DraftRoundEditor::NOTE_PLACEHOLDER') }}"
                                data-action="click->pin-placer#onClick keydown->pin-placer#onKeydown input->pin-placer#onInput focusin->pin-placer#onFocusin pointerdown->pin-placer#onPointerdown pointermove->pin-placer#onPointermove pointerup->pin-placer#onPointerend pointercancel->pin-placer#onPointerend"
                            >
                                <div class="draft-board__picture draft-board__picture--after">
                                    {% if hasRoundBefore %}<p class="round-compare__caption">After · this draft</p>{% endif %}
                                    <twig:Screenshot :view="this.pictureOf(item)" :showsText="false" class="round-compare__picture" loading="lazy" />
                                    <p class="pin-placer__status" role="status" data-pin-placer-target="status"></p>
                                </div>
                                <section class="draft-board__pins" aria-labelledby="{{ item.view.domId }}-pins-heading">
                                    <h2 class="round-panel__title" id="{{ item.view.domId }}-pins-heading">Pins</h2>
                                    <twig:PinList :view="item.view" :isEditable="true" :notePlaceholder="constant('App\\Review\\UI\\Component\\DraftRoundEditor::NOTE_PLACEHOLDER')" />
                                    <button type="button" class="btn btn-outline btn-sm pin-placer__add" data-pin-add data-action="pin-placer#addAtCentre">Add pin</button>
                                </section>
                                <div hidden data-pin-placer-target="fields"></div>
                            </div>

                            <div class="draft-shot__texts draft-board__texts" data-action="change->draft-round-editor#saveText">
                                <div class="screenshot-report__field">
                                    <label class="screenshot-report__label" for="{{ item.view.domId }}-title">Picture title · optional</label>
                                    <input class="screenshot-report__input" id="{{ item.view.domId }}-title" type="text" data-field="title" value="{{ item.view.title }}" maxlength="{{ this.titleMaxLength }}">
                                </div>
                                <div class="screenshot-report__field">
                                    <label class="screenshot-report__label" for="{{ item.view.domId }}-summary">Picture summary · optional</label>
                                    <textarea class="screenshot-report__input" id="{{ item.view.domId }}-summary" rows="3" data-field="summary" maxlength="{{ this.summaryMaxLength }}">{{ item.view.summary }}</textarea>
                                </div>
                            </div>

                            <div class="draft-shot__actions draft-board__remove">
                                <button type="button" class="btn btn-text btn-sm draft-shot__remove"
                                    data-action="live#action" data-live-action-param="removeScreenshot" data-live-screenshot-id-param="{{ item.screenshotId }}">{{ item.tryCount > 1 ? 'Remove this try' : 'Remove screenshot' }}</button>
                            </div>
                        {% endif %}
                    </section>
                {% endfor %}

                <div class="draft-round-editor__upload draft-board__upload" id="{{ editorId }}-upload" data-live-ignore>
                    <input class="visually-hidden" id="{{ editorId }}-file" type="file" accept="image/png,image/jpeg,image/webp" tabindex="-1" aria-hidden="true"
                        data-presigned-upload-target="input" data-draft-round-editor-target="file" data-action="change->presigned-upload#choose">
                    <button type="button" class="btn btn-outline draft-round-editor__add" data-action="draft-round-editor#pickFile">Add screenshot</button>
                    <img class="draft-round-editor__preview" alt="" hidden data-presigned-upload-target="preview">
                    <progress class="upload-field__progress" max="100" value="0" hidden aria-label="Upload progress" data-presigned-upload-target="progress"></progress>
                    <p class="upload-field__status" role="status" aria-live="polite" data-presigned-upload-target="status"></p>
                    <input type="hidden" data-presigned-upload-target="mediaId">
                </div>
            </div>
        </div>
    {% endif %}
</div>
