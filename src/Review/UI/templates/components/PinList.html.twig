{% if this.view.pins is not empty or this.isEditable %}
    <ol class="pin-list" aria-label="Pins" data-pin-placer-target="list">
        {% for pin in this.view.pins %}
            <li class="pin-list__item{% if pin.isAiSuggested %} pin-list__item--ai{% endif %}{% if pin.number == this.selectedNumber %} pin-list__item--selected{% endif %}" value="{{ pin.number }}" data-pin-number="{{ pin.number }}">
                <span class="pin-list__number">{{ pin.number }}</span>
                {% if this.isEditable %}
                    <textarea class="pin-list__note" name="pins[{{ pin.number }}][note]" rows="2" aria-label="Note for pin {{ pin.number }}">{{ pin.note }}</textarea>
                    <button type="button" class="btn btn-sm btn-text pin-list__remove" data-pin-remove aria-label="Remove pin {{ pin.number }}">Remove</button>
                {% else %}
                    <p class="pin-list__note">{% if pin.singleLineNote is same as('') %}(no note){% else %}{{ pin.note }}{% endif %}</p>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
{% endif %}
