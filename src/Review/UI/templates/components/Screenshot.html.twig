<figure{{ attributes.defaults({class: 'screenshot', id: this.view.domId}) }}>
    {% if this.showsText and (this.view.title is not null or this.view.summary is not null) %}
        <figcaption class="screenshot__text">
            {% if this.view.title is not null %}
                <{{ this.titleTag }} class="screenshot__title">{{ this.view.title }}</{{ this.titleTag }}>
            {% endif %}
            {% if this.view.summary is not null %}
                <p class="screenshot__summary">{{ this.view.summary }}</p>
            {% endif %}
        </figcaption>
    {% endif %}
    {% set hasKnownShape = not this.view.isReady and this.view.width is not null %}
    {#- The picture's shape sits on the frame, so the pin layer and the box are always the same size. The picture-shape controller sets it, as pin-layer places the pins: no style attribute, no style element. -#}
    <div class="screenshot__frame{% if not this.view.isReady %} screenshot__frame--placeholder{% endif %}{% if hasKnownShape %} screenshot__frame--shaped{% endif %}" id="{{ this.frameId }}"
        {%- if hasKnownShape %} data-controller="picture-shape" data-picture-shape-width-value="{{ this.view.width }}" data-picture-shape-height-value="{{ this.view.height }}"{% endif %}>
        {% if this.view.isReady %}
            <img class="screenshot__image" src="{{ this.view.imageUrl }}" alt="{{ this.view.altText }}" width="{{ this.view.width }}" height="{{ this.view.height }}" decoding="async"{% if this.loading is not null %} loading="{{ this.loading }}"{% endif %}>
        {% else %}
            {% if this.view.isPending %}
                <div class="screenshot__placeholder" id="{{ this.placeholderId }}" role="status">Processing…</div>
            {% else %}
                <div class="screenshot__placeholder screenshot__placeholder--rejected" id="{{ this.placeholderId }}">We could not process this image. Try again.</div>
            {% endif %}
        {% endif %}
        <twig:PinLayer :view="this.view" :selectedNumber="this.selectedNumber" />
    </div>
</figure>
