{% extends '@Web/base.html.twig' %}

{#- The full-screen review of one round (RoundController::focus, full-screen-review.md): a screen area, or a screenshot
    of a round without areas. The server shows the bar of the "?pin=" pin and hides the others; Previous, Next, the
    screenshots' Back and Next and After/Before are links and the verdicts plain forms, so the walk works without
    JavaScript. pin-walker switches bars in place, moves the selected ring, and adds the arrow keys and Escape. The pins
    are numbered markers with no note beside them: the bar shows it, with the area's pin verdicts or, for a pin that is
    a check item, the checklist buttons, whose forms come back here (ChecklistController). -#}

{% block title %}Full screen · Round {{ roundNumber }} · {{ ticketKey }} · pinround{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/review.css') }}">
{% endblock %}

{% block site_header %}{% endblock %}

{% block main %}
    {% set roundController = 'App\\Review\\UI\\Controller\\RoundController' %}
    {% set verdictController = 'App\\Review\\UI\\Controller\\VerdictController' %}
    {% set focusRoute = constant(roundController ~ '::FOCUS_ROUTE') %}
    {% set focusPath = {key: ticketKey, number: roundNumber} %}
    {% set shownQuery = focusPath|merge(page.shownParameters) %}
    <article class="focus-review" data-controller="pin-walker" data-pin-walker-parameter-value="{{ pinParameter }}" data-action="keydown@document->pin-walker#walk click->pin-walker#selectPin">
        <header class="focus-review__header">
            {#- A full load, as Escape's: the page left opens with the fragment already in its address, which fragment-focus reads to give the Full screen link its focus back. -#}
            <twig:Button variant="outline" size="sm" href="{{ exitHref }}" data-turbo="false" class="focus-review__exit" data-pin-walker-target="exit">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7"/></svg>
                Exit full screen
            </twig:Button>
            <h1 class="focus-review__line">{{ page.line }}</h1>
            {% if page.hasBefore %}
                <twig:SegmentedControl label="Picture" class="focus-review__sides" :links="[
                    {label: 'After', href: path(focusRoute, shownQuery|merge({(sideParameter): 'after'})|merge(returnParameters)), isCurrent: page.side == 'after'},
                    {label: 'Before', href: path(focusRoute, shownQuery|merge({(sideParameter): 'before'})|merge(returnParameters)), isCurrent: page.side == 'before'},
                ]" />
            {% endif %}
            {% if copyToDraft is not null %}
                {{ include('@Review/_copy_to_draft_form.html.twig', {ticketKey: ticketKey, source: copyToDraft, csrfId: draftCsrfId, formClass: 'focus-review__copy-to-draft', size: 'sm'}, with_context = false) }}
            {% endif %}
            {% if page.pager is not null %}
                {% set pager = page.pager %}
                <nav class="focus-review__pager" aria-label="{{ constant('App\\Review\\UI\\RoundPage\\ScreenshotPager::NAV_LABEL') }}">
                    <twig:Button variant="outline" size="sm" href="{{ path(focusRoute, focusPath|merge(pager.backParameters ?? {})|merge(returnParameters)) }}" :disabled="pager.backParameters is null" class="focus-review__back" rel="prev"><span aria-hidden="true">&lt;</span> Back</twig:Button>
                    <twig:Button variant="outline" size="sm" href="{{ path(focusRoute, focusPath|merge(pager.nextParameters ?? {})|merge(returnParameters)) }}" :disabled="pager.nextParameters is null" class="focus-review__next" rel="next">Next <span aria-hidden="true">&gt;</span></twig:Button>
                </nav>
            {% endif %}
        </header>

        {% if page.picture is null %}
            <twig:EmptyState message="{{ page.emptyMessage }}" />
        {% else %}
            <twig:Screenshot :view="page.picture" :selectedNumber="page.current.number ?? null" class="screenshot--markers focus-review__picture" />

            {% if page.current is null %}
                <p class="focus-review__none">{{ page.areaPosition is null ? 'This screenshot has no pins.' : 'There are no earlier pins to check here.' }}</p>
            {% else %}
                {% set csrfField = constant(verdictController ~ '::CSRF_FIELD') %}
                {% set verdictField = constant(verdictController ~ '::VERDICT_FIELD') %}
                {% set focusSideField = constant(verdictController ~ '::FOCUS_SIDE_FIELD') %}
                {% set focusAreaField = constant(verdictController ~ '::FOCUS_AREA_FIELD') %}
                {% set focusPinField = constant(verdictController ~ '::FOCUS_PIN_FIELD') %}
                {% set csrfToken = page.mayGiveVerdicts ? csrf_token(verdictCsrfId) : null %}
                {% set checklistController = 'App\\Review\\UI\\Controller\\ChecklistController' %}
                {% set hasCheckControls = page.stops|filter(stop => stop.check is not null and (stop.check.mayMarkFixed or stop.check.mayCheck)) is not empty %}
                {% set checklistToken = hasCheckControls ? csrf_token(checklistCsrfId) : null %}
                <div class="focus-bar" aria-live="polite">
                    {% for stop in page.stops %}
                        {% set isCurrent = stop.position == page.current.position %}
                        {% set stopQuery = shownQuery|merge(page.areaPosition is null and not page.hasBefore ? {} : {(sideParameter): page.side})|merge(returnParameters) %}
                        <section class="focus-bar__stop" id="focus-pin-{{ stop.position }}" aria-labelledby="focus-pin-{{ stop.position }}-label" data-pin-walker-target="stop" data-pin-number="{{ stop.number }}" data-pin-position="{{ stop.position }}"{% if not isCurrent %} hidden{% endif %}>
                            <a class="icon-btn focus-bar__step" href="{{ path(focusRoute, stopQuery|merge({(pinParameter): stop.previousPosition})) }}" aria-label="Previous pin" data-pin-walker-control="previous" data-action="pin-walker#previous">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                            </a>
                            {#- The text and the choices wrap inside this body, so the arrows stay at the bar's two ends at any width. -#}
                            <div class="focus-bar__body">
                                <div class="focus-bar__text">
                                    <h2 class="focus-bar__label" id="focus-pin-{{ stop.position }}-label">{{ stop.label }}</h2>
                                    {#- tabindex: a long note scrolls inside the bar (review.css), and a keyboard scrolls only what it can focus. -#}
                                    {#- A check item with no button left, as after OK, gives the focus to its note, which keeps the person in the bar. -#}
                                    {% set isNoteFocused = isCurrent and not page.mayGiveVerdicts and stop.check is not null and not stop.check.mayMarkFixed and not stop.check.mayCheck %}
                                    <p class="focus-bar__note" tabindex="0"{% if isNoteFocused %} autofocus{% endif %}>{% if stop.note|trim is same as('') %}(no note){% else %}{{ stop.note }}{% endif %}</p>
                                </div>
                                {% if page.mayGiveVerdicts %}
                                    {% set focusFields %}
                                        <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">
                                        <input type="hidden" name="{{ focusSideField }}" value="{{ page.side }}">
                                        <input type="hidden" name="{{ focusAreaField }}" value="{{ page.areaPosition }}">
                                        <input type="hidden" name="{{ focusPinField }}" value="{{ stop.position }}">
                                    {% endset %}
                                    {% if stop.isChecked %}
                                        <form method="post" action="{{ path(constant(verdictController ~ '::PIN_UNDO_ROUTE'), {key: ticketKey, number: roundNumber, pinId: stop.id}) }}" class="focus-bar__choices">
                                            {{ focusFields }}
                                            <twig:Button type="submit" variant="text" :autofocus="isCurrent" data-pin-walker-control="undo">Undo</twig:Button>
                                        </form>
                                    {% else %}
                                        <form method="post" action="{{ path(constant(verdictController ~ '::PIN_VERDICT_ROUTE'), {key: ticketKey, number: roundNumber, pinId: stop.id}) }}" class="focus-bar__choices">
                                            {{ focusFields }}
                                            <twig:Button type="submit" variant="tonal" :autofocus="isCurrent" name="{{ verdictField }}" value="{{ constant('App\\Review\\Api\\VerdictCommands::PIN_FIXED') }}" data-pin-walker-control="fixed">Fixed</twig:Button>
                                            <twig:Button type="submit" variant="text" name="{{ verdictField }}" value="{{ constant('App\\Review\\Api\\VerdictCommands::PIN_STILL_WRONG') }}" data-pin-walker-control="still-wrong">Still wrong</twig:Button>
                                        </form>
                                    {% endif %}
                                {% endif %}
                                {% if stop.check is not null %}
                                    {% set checkReturnFields %}
                                        <input type="hidden" name="{{ constant(checklistController ~ '::RETURN_ROUND_FIELD') }}" value="{{ roundNumber }}">
                                        <input type="hidden" name="{{ constant(checklistController ~ '::RETURN_SCREENSHOT_FIELD') }}" value="{{ page.shownParameters[constant(roundController ~ '::SCREENSHOT_PARAMETER')] ?? '' }}">
                                        <input type="hidden" name="{{ constant(checklistController ~ '::RETURN_SIDE_FIELD') }}" value="{{ page.side }}">
                                        <input type="hidden" name="{{ constant(checklistController ~ '::RETURN_PIN_FIELD') }}" value="{{ stop.position }}">
                                    {% endset %}
                                    <div class="focus-bar__choices">
                                        <twig:Tag class="check-state {{ stop.check.stateClass }}">{{ stop.check.stateLabel }}</twig:Tag>
                                        {#- The pin verdicts take the focus where the bar has them; a screenshot's stop has none. -#}
                                        {{ include('@Review/_check_item_forms.html.twig', {
                                            check: stop.check,
                                            ticketKey: ticketKey,
                                            csrfToken: checklistToken,
                                            returnFields: checkReturnFields,
                                            formClass: 'focus-bar__choices',
                                            buttonSize: 'md',
                                            notFixedVariant: 'text',
                                            describedBy: null,
                                            isWalkerStop: true,
                                            autofocusFirst: isCurrent and not page.mayGiveVerdicts,
                                        }, with_context = false) }}
                                    </div>
                                {% endif %}
                            </div>
                            <a class="icon-btn focus-bar__step" href="{{ path(focusRoute, stopQuery|merge({(pinParameter): stop.nextPosition})) }}" aria-label="Next pin" data-pin-walker-control="next" data-action="pin-walker#next">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                            </a>
                        </section>
                    {% endfor %}
                </div>
            {% endif %}
        {% endif %}
    </article>
{% endblock %}
