{% extends '@Web/base.html.twig' %}

{#- The owner's private draft round on its own page (DraftRoundController::page), laid out as the round page: the
    editor (DraftRoundEditor) with its header, tabs, pictures and side panel, the "Use Claude Code" box at its foot. -#}

{% block title %}Draft round · {{ ticketKey }} · pinround{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/review.css') }}">
{% endblock %}

{% block main %}
    <article class="round-page draft-page" aria-labelledby="round-{{ roundId }}-heading">
        <twig:DraftRoundEditor :ticketKey="ticketKey" :roundId="roundId" :shownNumber="shownNumber" />
    </article>
{% endblock %}
