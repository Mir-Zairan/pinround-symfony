{#- The round page's strip, from RoundPages: a link per screenshot with its small picture, its name and its pin count or,
    for a screen area, its state, whose tag a verdict's Turbo Stream replaces by its id. -#}
<nav class="screenshot-strip" aria-label="{{ page.stripLabel }}">
    <ol class="screenshot-strip__list">
        {% for thumb in page.thumbs %}
            <li class="screenshot-strip__item">
                <a class="screenshot-thumb" href="{{ path(roundRoute, {key: page.ticketKey, number: roundNumber}|merge(thumb.parameters)) }}"{% if thumb.isShown %} aria-current="page"{% endif %}>
                    {% if thumb.imageUrl is not null %}
                        <img class="screenshot-thumb__image" src="{{ thumb.imageUrl }}" alt=""
                            {%- if thumb.hasImageSize %} width="{{ thumb.imageWidth }}" height="{{ thumb.imageHeight }}"{% endif %} decoding="async">
                    {% else %}
                        <span class="screenshot-thumb__image screenshot-thumb__image--none" aria-hidden="true"></span>
                    {% endif %}
                    <span class="screenshot-thumb__label">{{ thumb.label }}</span>
                    {{ include('@Review/_screenshot_thumb_tag.html.twig', {tagLabel: thumb.tagLabel, tagClass: thumb.tagClass, tagId: thumb.tagId}, with_context = false) }}
                </a>
            </li>
        {% endfor %}
    </ol>
</nav>
