{% extends '@Web/base.html.twig' %}

{% block title %}{{ heading }} · pinround{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/tickets.css') }}">
{% endblock %}

{% block main %}
    <div class="tickets-page" {{ stimulus_controller('ticket-list') }}
        data-action="ticket-filters:changed->ticket-list#show turbo:frame-load->ticket-list#announce">
        {% embed '@Ticketing/_filters_panel.html.twig' %}
            {% block filters %}
                <twig:TicketFilters project="{{ filters.project }}" projectId="{{ filters.projectId }}" person="{{ filters.person }}" :showsDone="filters.showsDone" q="{{ filters.q }}" team="{{ filters.team }}" pickedTeam="{{ filters.pickedTeam }}" />
            {% endblock %}
        {% endembed %}

        <header class="tickets__header">
            <h1 class="tickets__title">{{ heading }}</h1>
            {# Outside the frame, so it stays in the page and screen readers hear each new count; ticket-list copies it from the loaded frame. #}
            <p class="tickets__total" role="status" {{ stimulus_target('ticket-list', 'total') }}>{{ totalLine }}</p>
            {# Only the project and the picked team, which change by a full page load, so these links never go stale. #}
            {% set viewQuery = {project: filters.project, team: filters.pickedTeam}|filter(value => value != '') %}
            <twig:SegmentedControl label="View" :links="[{label: 'List', href: path('ticketing_tickets', viewQuery), isCurrent: true}, {label: 'Whose turn?', href: path('ticketing_whose_turn', viewQuery), isCurrent: false}]" />
        </header>

        {# TicketFilters sends the list's new URL after each change; ticket-list loads it into this frame and the rail's. #}
        {{ include('@Ticketing/_list_frame.html.twig') }}
    </div>
{% endblock %}
