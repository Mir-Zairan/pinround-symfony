{% extends '@Web/base.html.twig' %}

{% block title %}{{ heading }} · pinround{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/tickets.css') }}">
{% endblock %}

{% block main %}
    <div class="tickets" id="ticket-list">
        <header class="tickets__header">
            <h1 class="tickets__title">{{ heading }}</h1>
            <p class="tickets__total">{{ totalLine }}</p>
        </header>

        {# The next task wraps this in a Turbo frame and remembers collapsed steps through these ids and data-step hooks. #}
        <div class="tickets__results" id="ticket-list-results">
            {% for group in groups %}
                {% for step in group.steps %}
                    <section class="tickets__step" id="step-{{ step.id }}" data-group="{{ group.code }}" data-step-id="{{ step.id }}">
                        <h2 class="tickets__step-heading">
                            <button type="button" class="tickets__step-toggle" aria-expanded="true" aria-controls="step-{{ step.id }}-rows"
                                data-step-toggle>
                                <span class="tickets__chevron" aria-hidden="true">▾</span>
                                <span class="tickets__dot tickets__dot--{{ group.code }}" aria-hidden="true"></span>
                                <span class="tickets__step-name">{{ step.name }}</span>
                                <span class="tickets__step-count">{{ step.count }}</span>
                                <twig:Tag>{{ group.label }}</twig:Tag>
                            </button>
                            {% if group.hint is not null %}
                                <span class="tickets__hint">{{ group.hint }}</span>
                            {% endif %}
                        </h2>
                        <div class="tickets__rows" id="step-{{ step.id }}-rows">
                            <ul class="tickets__row-list">
                                {% for row in step.rows %}
                                    <li class="tickets__row" data-ticket-key="{{ row.key }}">
                                        <span class="tickets__key">{{ row.key }}</span>
                                        <span class="tickets__summary">
                                            <span class="tickets__row-title">{{ row.title }}</span>
                                            <span class="tickets__meta">{{ row.meta }}</span>
                                        </span>
                                        <span class="tickets__priority{% if row.isUrgent %} tickets__priority--urgent{% endif %}">{{ row.priority }}</span>
                                        {% if row.assigneeName is not null %}
                                            <twig:Avatar name="{{ row.assigneeName }}" title="Assigned to {{ row.assigneeName }}" class="tickets__assignee" />
                                        {% else %}
                                            <span class="av tickets__assignee tickets__assignee--nobody" role="img" aria-label="Nobody assigned">–</span>
                                        {% endif %}
                                        <time class="tickets__updated" datetime="{{ row.updatedAt }}">{{ row.updated }}</time>
                                    </li>
                                {% endfor %}
                            </ul>
                            {% if step.moreUrl is not null %}
                                <a class="tickets__more" href="{{ step.moreUrl }}" data-step-more>Show more</a>
                            {% endif %}
                        </div>
                    </section>
                {% endfor %}
            {% else %}
                <twig:EmptyState message="{{ noTickets }}" />
            {% endfor %}
        </div>
    </div>
{% endblock %}
