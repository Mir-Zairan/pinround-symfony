{#- TicketMoveController's answer to a Turbo form: the ticket's state, its Your next step box, its Rounds, People and What happened as they are now, then the toast. -#}
<turbo-stream action="replace" target="{{ constant('App\\Ticketing\\UI\\TicketPageParts::STATE_ID') }}"><template>{{ include('@Ticketing/_ticket_state.html.twig') }}</template></turbo-stream>
<turbo-stream action="replace" target="{{ constant('App\\Ticketing\\UI\\TicketPageParts::NEXT_STEP_ID') }}"><template>{{ include('@Ticketing/_next_step.html.twig', {isStreamed: true}) }}</template></turbo-stream>
<turbo-stream action="replace" target="{{ constant('App\\Ticketing\\UI\\TicketPageParts::ROUNDS_ID') }}"><template>{{ include('@Ticketing/_rounds.html.twig') }}</template></turbo-stream>
<turbo-stream action="replace" target="{{ constant('App\\Ticketing\\UI\\TicketPageParts::PEOPLE_ID') }}"><template>{{ include('@Ticketing/_people.html.twig') }}</template></turbo-stream>
<turbo-stream action="replace" target="{{ constant('App\\Ticketing\\UI\\TicketPageParts::ACTIVITY_ID') }}"><template>{{ include('@Ticketing/_activity.html.twig') }}</template></turbo-stream>
{{ include('@Web/_toast_stream.html.twig', {message: toast, action: toastAction|default(null)}) }}
