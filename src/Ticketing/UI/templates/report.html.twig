{% extends '@Web/base.html.twig' %}

{#- Report a problem (ReportController, report-a-problem.md): the title, the detail, the screenshot with pins, then
    "Where it goes" (_report_where_it_goes.html.twig, which a report draft's page shows too). -#}

{% block title %}Report a problem · pinround{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/profile.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/review.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/screenshot-editor.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/intake-check.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/report.css') }}">
{% endblock %}

{% block main %}
    <div class="report">
        <h1 class="report__title">Report a problem</h1>
        <p class="report__lede">Anyone can do this. It becomes a ticket as soon as you send it. Nobody has to approve it first.</p>
        {# Review owns the drafts (ADR-0040); this page only links to them. #}
        <p class="report__drafts"><a class="report__drafts-link" href="{{ path('review_report_drafts') }}">Your report drafts</a> · Claude Code and the browser extension can prepare a report for you to check and send</p>
        {% if errors.form is defined %}
            <p class="login__error" role="alert">{{ errors.form }}</p>
        {% endif %}

        {%- set personPicked = input.personPickedFields %}
        <form class="report__form" method="post" action="{{ path('ticketing_report') }}" novalidate
            data-controller="report-form"
            data-report-form-preview-url-value="{{ path('ticketing_report_preview') }}"
            data-action="input->report-form#schedulePreview change->report-form#schedulePreview"
            {%- if personPicked is not empty %} data-intake-check-person-picked="{{ personPicked|join(' ') }}"{% endif %}>
            <div class="report__field">
                <label class="form-field">
                    What is wrong, in one line
                    <input class="form-field__input" type="text" name="title" value="{{ input.title }}" maxlength="{{ titleMaxLength }}" required autocomplete="off"
                        placeholder="For example: The cart total is counted twice"
                        {%- if errors.title is defined %} aria-invalid="true" aria-describedby="report-title-error"{% endif %}>
                </label>
                {% if errors.title is defined %}
                    <p class="profile__error" id="report-title-error">{{ errors.title }}</p>
                {% endif %}
            </div>

            <div data-report-form-target="duplicates">{% include '@Ticketing/_report_duplicates.html.twig' with {duplicates: duplicates} only %}</div>

            <div class="report__field">
                <label class="form-field">
                    More detail · optional
                    <textarea class="form-field__input" name="description" rows="5" maxlength="{{ descriptionMaxLength }}"
                        placeholder="What did you do, what did you expect, what happened?"
                        {%- if errors.description is defined %} aria-invalid="true" aria-describedby="report-description-error"{% endif %}>{{ input.description }}</textarea>
                </label>
                {% if errors.description is defined %}
                    <p class="profile__error" id="report-description-error">{{ errors.description }}</p>
                {% endif %}
            </div>

            {% if uploadProjectKey %}
                <twig:ScreenshotReportField :uploadTargetKind="uploadTargetKind" :uploadTargetId="uploadProjectKey" :postedReport="report" :error="errors.screenshot|default(null)" :offersCapture="true" :usesScreenshotEditor="true" />
            {% endif %}

            {% include '@Ticketing/_report_where_it_goes.html.twig' with {showsIntakeCheck: true} %}

            <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrfId) }}">
            <div class="report__footer">
                <p class="report__preview" role="status" aria-live="polite"{% if preview == '' %} hidden{% endif %} data-report-form-target="previewLine"><strong>When you send:</strong> <span data-report-form-target="preview">{{ preview }}</span></p>
                <div class="report__buttons">
                    <twig:Button variant="text" href="{{ path('web_home') }}">Cancel</twig:Button>
                    <twig:Button type="submit">Create ticket</twig:Button>
                </div>
            </div>
        </form>
    </div>
{% endblock %}
