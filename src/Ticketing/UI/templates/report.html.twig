{% extends '@Web/base.html.twig' %}

{#- Report a problem (ReportController, report-a-problem.md): the title, the detail, the screenshot with pins, then
    "Where it goes". Team, Give it to, Project, Type and Priority are radio chips. Each team's "Give it to" and projects
    are their own group; the report-form controller shows the chosen team's and clears "Give it to" on a team change.
    Without script the reporter's own team's groups show, and the server refuses a pick that does not fit the team. -#}

{% block title %}Report a problem · pinround{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/profile.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/review.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/screenshot-editor.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/intake-check.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/report.css') }}">
{% endblock %}

{% block main %}
    <div class="report">
        <h1 class="report__title">Report a problem</h1>
        <p class="report__lede">Anyone can do this. It becomes a ticket as soon as you send it. Nobody has to approve it first.</p>
        {# Review owns the drafts (ADR-0040); this page only links to them. #}
        <p class="report__drafts"><a class="report__drafts-link" href="{{ path('review_report_drafts') }}">Your report drafts</a> · reports your Claude Code or the browser extension prepared</p>
        {% if errors.form is defined %}
            <p class="login__error" role="alert">{{ errors.form }}</p>
        {% endif %}

        {%- set personPicked = input.personPickedFields %}
        <form class="report__form" method="post" action="{{ path('ticketing_report') }}" novalidate
            data-controller="report-form"
            data-report-form-preview-url-value="{{ path('ticketing_report_preview') }}"
            data-action="input->report-form#schedulePreview change->report-form#schedulePreview"
            {%- if personPicked is not empty %} data-intake-check-person-picked="{{ personPicked|join(' ') }}"{% endif %}>
            <div class="report__field">
                <label class="login__field">
                    What is wrong, in one line
                    <input class="login__input" type="text" name="title" value="{{ input.title }}" maxlength="{{ titleMaxLength }}" required autocomplete="off"
                        placeholder="For example: The cart total is counted twice"
                        {%- if errors.title is defined %} aria-invalid="true" aria-describedby="report-title-error"{% endif %}>
                </label>
                {% if errors.title is defined %}
                    <p class="profile__error" id="report-title-error">{{ errors.title }}</p>
                {% endif %}
            </div>

            <div data-report-form-target="duplicates">{% include '@Ticketing/_report_duplicates.html.twig' with {duplicates: duplicates} only %}</div>

            <div class="report__field">
                <label class="login__field">
                    More detail · optional
                    <textarea class="login__input" name="description" rows="5" maxlength="{{ descriptionMaxLength }}"
                        placeholder="What did you do, what did you expect, what happened?"
                        {%- if errors.description is defined %} aria-invalid="true" aria-describedby="report-description-error"{% endif %}>{{ input.description }}</textarea>
                </label>
                {% if errors.description is defined %}
                    <p class="profile__error" id="report-description-error">{{ errors.description }}</p>
                {% endif %}
            </div>

            {% if uploadProjectKey %}
                <twig:ScreenshotReportField :uploadTargetKind="uploadTargetKind" :uploadTargetId="uploadProjectKey" :postedReport="report" :error="errors.screenshot|default(null)" :offersCapture="true" :usesScreenshotEditor="true" />
            {% endif %}

            <fieldset class="where-it-goes report__where">
                <legend class="where-it-goes__title">Where it goes</legend>
                {# Assist's check by its component name, as Ticketing's UI may not use Assist (deptrac.yaml); inside the form, so its button posts the typed fields. #}
                {{ component('IntakeCheck') }}

                <fieldset class="report__chips"{% if errors.team is defined %} aria-describedby="report-team-error"{% endif %}>
                    <legend class="report__label">Team</legend>
                    <div class="report__chip-row">
                        {% for team in teams %}
                            <label class="chip report__chip">
                                <input class="visually-hidden" type="radio" name="team_id" value="{{ team.id.toString }}"{% if team.id.toString == input.teamId %} checked{% endif %}
                                    data-report-form-target="team" data-action="report-form#chooseTeam">
                                {{ team.name }}
                            </label>
                        {% endfor %}
                        <label class="chip report__chip">
                            <input class="visually-hidden" type="radio" name="team_id" value="{{ noTeam }}"{% if input.teamId == noTeam %} checked{% endif %}
                                data-report-form-target="team" data-action="report-form#chooseTeam">
                            Not sure
                        </label>
                    </div>
                    {% if errors.team is defined %}
                        <p class="profile__error" id="report-team-error">{{ errors.team }}</p>
                    {% endif %}
                </fieldset>

                {% for team in teams|filter(team => team.isOwn) %}
                    <fieldset class="report__chips" data-report-form-target="giveTo" data-team="{{ team.id.toString }}"{% if team.id.toString != input.teamId %} hidden{% endif %}
                        {%- if errors.assignee is defined %} aria-describedby="report-assignee-error"{% endif %}>
                        <legend class="report__label">Give it to</legend>
                        <div class="report__chip-row">
                            <label class="chip report__chip">
                                <input class="visually-hidden" type="radio" name="assignee_id" value=""{% if input.assigneeId == '' %} checked{% endif %}{% if team.id.toString != input.teamId %} disabled{% endif %}>
                                The team{% if team.giveTo.leadFirstName is not null %} ({{ team.giveTo.leadFirstName }} decides){% endif %}
                            </label>
                            {% for person in team.giveTo.people %}
                                <label class="chip report__chip">
                                    <input class="visually-hidden" type="radio" name="assignee_id" value="{{ person.id }}"{% if person.id == input.assigneeId and team.id.toString == input.teamId %} checked{% endif %}{% if team.id.toString != input.teamId %} disabled{% endif %}>
                                    {{ person.label }}
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>
                {% endfor %}
                {% if errors.assignee is defined %}
                    <p class="profile__error" id="report-assignee-error">{{ errors.assignee }}</p>
                {% endif %}

                {% for team in teams %}
                    {% include '@Ticketing/_report_projects.html.twig' with {groupTeam: team.id.toString, projects: team.projects, isShown: team.id.toString == input.teamId} %}
                {% endfor %}
                {% include '@Ticketing/_report_projects.html.twig' with {groupTeam: noTeam, projects: notSureProjects, isShown: input.teamId == noTeam} %}
                {% if errors.project is defined %}
                    <p class="profile__error" id="report-project-error">{{ errors.project }}</p>
                {% endif %}

                <fieldset class="report__chips"{% if errors.type is defined %} aria-describedby="report-type-error"{% endif %}>
                    <legend class="report__label">Type</legend>
                    <div class="report__chip-row">
                        {% for value, typeLabel in typeLabels %}
                            <label class="chip report__chip">
                                <input class="visually-hidden" type="radio" name="type" value="{{ value }}"{% if value == input.type %} checked{% endif %}>
                                {{ typeLabel }}
                            </label>
                        {% endfor %}
                    </div>
                    {% if errors.type is defined %}
                        <p class="profile__error" id="report-type-error">{{ errors.type }}</p>
                    {% endif %}
                </fieldset>

                <fieldset class="report__chips"{% if errors.priority is defined %} aria-describedby="report-priority-error"{% endif %}>
                    <legend class="report__label">Priority</legend>
                    <div class="report__chip-row">
                        {% for value, priorityLabel in priorityLabels %}
                            <label class="chip report__chip">
                                <input class="visually-hidden" type="radio" name="priority" value="{{ value }}"{% if value == input.priority %} checked{% endif %}>
                                {{ priorityLabel }}
                            </label>
                        {% endfor %}
                    </div>
                    {% if errors.priority is defined %}
                        <p class="profile__error" id="report-priority-error">{{ errors.priority }}</p>
                    {% endif %}
                </fieldset>
            </fieldset>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrfId) }}">
            <div class="report__footer">
                <p class="report__preview" role="status" aria-live="polite"{% if preview == '' %} hidden{% endif %} data-report-form-target="previewLine"><strong>When you send:</strong> <span data-report-form-target="preview">{{ preview }}</span></p>
                <div class="report__buttons">
                    <twig:Button variant="text" href="{{ path('web_home') }}">Cancel</twig:Button>
                    <twig:Button type="submit">Create ticket</twig:Button>
                </div>
            </div>
        </form>
    </div>
{% endblock %}
