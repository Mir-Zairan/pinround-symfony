{# The list frame alone, as the whole page holds it and as a Turbo frame request gets it. Links inside leave the page (_top) unless a nested frame owns them. #}
        <turbo-frame id="ticket-list-frame" target="_top" {{ stimulus_target('ticket-list', 'frame') }}>
        {# "Show more" is a link inside a Turbo frame named by the page it opens; the response holds a frame of the same id around that page's rows, so only they replace the link. Without script the link opens the whole page. #}
        <div class="tickets__results" id="ticket-list-results" data-total-line="{{ totalLine }}">
            {% for group in groups %}
                {% for step in group.steps %}
                    <section class="tickets__step" id="step-{{ step.id }}" data-group="{{ group.code }}" data-step-id="{{ step.id }}"
                        {{ stimulus_controller('step-collapse', {url: step.collapseUrl, token: csrf_token(step.csrfId)}) }}>
                        <div class="tickets__step-header">
                        <h2 class="tickets__step-heading">
                            <button type="button" class="tickets__step-toggle" aria-expanded="{{ step.isCollapsed ? 'false' : 'true' }}" aria-controls="step-{{ step.id }}-rows"
                                {{ stimulus_target('step-collapse', 'toggle') }} data-step-toggle data-action="step-collapse#toggle">
                                <span class="tickets__chevron" aria-hidden="true">▾</span>
                                <span class="tickets__dot tickets__dot--{{ group.code }}" aria-hidden="true"></span>
                                <span class="tickets__step-name">{{ step.name }}</span>
                                <span class="tickets__step-count">{{ step.count }}</span>
                                <twig:Tag>{{ group.label }}</twig:Tag>
                            </button>
                            {% if group.hint is not null %}
                                <span class="tickets__hint">{{ group.hint }}</span>
                            {% endif %}
                        </h2>
                        <form method="post" action="{{ queueStartUrl }}" class="tickets__go-through" data-turbo-frame="_top">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token(queueCsrfId) }}">
                            <input type="hidden" name="{{ queueStepField }}" value="{{ step.id }}">
                            <twig:Button type="submit" variant="outline" size="sm" aria-label="Go through them: {{ step.name }}">Go through them</twig:Button>
                        </form>
                        </div>
                        <div class="tickets__rows" id="step-{{ step.id }}-rows" {{ stimulus_target('step-collapse', 'rows') }}{% if step.isCollapsed %} hidden{% endif %}>
                            {% if step.pageFrameId is not null %}<turbo-frame id="{{ step.pageFrameId }}">{% endif %}
                            {# No hover prefetch: inside a frame Turbo prefetches links even with Drive off, and each would cost a ticket page's queries. #}
                            <ul class="tickets__row-list" data-turbo-prefetch="false"{% if step.pageFrameId is not null %} tabindex="-1" autofocus{% endif %}>
                                {% for row in step.rows %}
                                    <li class="tickets__row" data-ticket-key="{{ row.key }}">
                                        <span class="tickets__key">{{ row.key }}</span>
                                        <span class="tickets__summary">
                                            {# _top: a row inside a "Show more" frame must open the whole ticket page, not replace that frame. #}
                                            <a class="tickets__row-title tickets__row-link" href="{{ path('ticket_show', {key: row.key}|merge(listQuery)) }}" data-turbo-frame="_top">{{ row.title }}</a>
                                            <span class="tickets__meta">{{ row.meta }}</span>
                                        </span>
                                        <span class="tickets__priority{% if row.isUrgent %} tickets__priority--urgent{% endif %}">{{ row.priority }}</span>
                                        {% if row.assigneeName is not null %}
                                            <twig:Avatar name="{{ row.assigneeName }}" title="Assigned to {{ row.assigneeName }}" class="tickets__assignee" />
                                        {% else %}
                                            <span class="av tickets__assignee tickets__assignee--nobody" role="img" aria-label="Nobody assigned">–</span>
                                        {% endif %}
                                        <time class="tickets__updated" datetime="{{ row.updatedAt }}">{{ row.updated }}</time>
                                    </li>
                                {% endfor %}
                            </ul>
                            {% if step.moreUrl is not null %}
                                <turbo-frame id="{{ step.moreFrameId }}">
                                    <a class="tickets__more" href="{{ step.moreUrl }}" data-step-more>Show more</a>
                                </turbo-frame>
                            {% endif %}
                            {% if step.pageFrameId is not null %}</turbo-frame>{% endif %}
                        </div>
                    </section>
                {% endfor %}
            {% else %}
                <twig:EmptyState message="{{ noTickets }}" />
            {% endfor %}
        </div>
        </turbo-frame>
