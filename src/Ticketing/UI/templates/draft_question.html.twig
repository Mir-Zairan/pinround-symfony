{% extends '@Web/base.html.twig' %}

{% block title %}Share your draft round? · pinround{% endblock %}

{#- The answer to a move form sent without script: the same question as the dialog, on a page of its own. -#}
{% block main %}
    <div class="profile">
        <h1 class="profile__title">Share your draft round?</h1>
        <twig:Card>
            <p>Your draft round has {{ draft.screenshotCount }} {{ 1 == draft.screenshotCount ? 'screenshot' : 'screenshots' }}. Share it with the team as round {{ draft.roundNumber }}, or keep it private. Private notes stay readable for you and Claude Code.</p>
            <form method="post" action="{{ moveUrl }}">
                {{ include('@Ticketing/_draft_question_fields.html.twig') }}
                <twig:Button variant="text" href="{{ path('ticket_show', {key: ticketKey}) }}">Cancel</twig:Button>
                <twig:Button type="submit" variant="outline" name="{{ choiceField }}" value="keep">Keep private and move</twig:Button>
                <twig:Button type="submit" name="{{ choiceField }}" value="share">{{ null == stepName ? 'Share and move' : 'Share and move to ' ~ stepName }}</twig:Button>
            </form>
        </twig:Card>
    </div>
{% endblock %}
