{% extends '@Web/base.html.twig' %}

{% block title %}{{ ticket.key }} · {{ ticket.title }} · pinround{% endblock %}

{% block head %}
    {# Turbo must not show a cached copy of a ticket, whose step and people change (frontend.md, Turbo and real-time updates). #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/ticket.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/thread.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/ping-sheet.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/review.css') }}">
{% endblock %}

{% block live_updates %}
    {#- Notification's component, by name, as Ticketing's UI may not use Notification (deptrac.yaml). A refresh signal
        fetches again what carries data-live-refresh: the thread's and the rounds' frames and the parts a move's Turbo Stream replaces. -#}
    {{ component('LiveUpdates', {ticketId: ticket.id.toString}) }}
{% endblock %}

{% block main %}
    {% if queueBar is not null %}
        <twig:QueueBar
            label="{{ queueBar.label }}"
            :place="queueBar.place"
            :count="queueBar.count"
            :previousUrl="queueBar.previousUrl"
            :nextUrl="queueBar.nextUrl"
            finishUrl="{{ queueBar.finishUrl }}"
            stopUrl="{{ queueBar.stopUrl }}"
            csrfToken="{{ csrf_token(queueBar.csrfId) }}"
        />
    {% endif %}
    <article class="ticket" data-ticket-key="{{ ticket.key }}">
        <header class="ticket__header">
            {# One wrapping row, as the prototype has it: back, key · type · project, tags, then the position on the right edge. #}
            <div class="ticket__key-row">
                {% if queueBar is not null %}
                    {# Leaving for the list ends the queue, so Back is a Stop that opens the list. #}
                    <form method="post" action="{{ queueBar.stopUrl }}" class="ticket__back-form" data-turbo-frame="_top">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token(queueBar.csrfId) }}">
                        <input type="hidden" name="{{ constant('App\\Ticketing\\UI\\QueueController::BACK_FIELD') }}" value="1">
                        <twig:Button type="submit" variant="text" class="ticket__back"><span aria-hidden="true">&lt;</span> Tickets</twig:Button>
                    </form>
                {% else %}
                    <twig:Button variant="text" href="{{ path('ticketing_tickets', backQuery) }}" class="ticket__back"><span aria-hidden="true">&lt;</span> Tickets</twig:Button>
                {% endif %}
                <p class="ticket__key-line">
                    <span class="ticket__key">{{ ticket.key }}</span>
                    <span aria-hidden="true">·</span>
                    <span class="ticket__kind">{{ type }} · {{ ticket.projectName }}</span>
                    {% if ticket.isTeamOnly %}<twig:Tag class="ticket__team-only">Only the team and admins see this</twig:Tag>{% endif %}
                </p>
                {% if position is not null %}
                    <nav class="ticket__position" aria-label="Tickets in this list" data-turbo-prefetch="false">
                        <span class="ticket__position-line">{{ position.line }}</span>
                        <twig:Button variant="outline" size="sm" href="{{ position.previousUrl ?? '' }}" :disabled="position.previousUrl is null" class="ticket__previous">Previous</twig:Button>
                        <twig:Button variant="outline" size="sm" href="{{ position.nextUrl ?? '' }}" :disabled="position.nextUrl is null" class="ticket__next-ticket">Next</twig:Button>
                    </nav>
                {% endif %}
            </div>
            <h1 class="ticket__title">{{ ticket.title }}</h1>
            {{ include('@Ticketing/_ticket_state.html.twig') }}
        </header>

        {#- The parts in the order a phone shows them, so keyboard focus follows what people see (WCAG 2.4.3): the main
            column, the Your next step box, the Rounds, the aside. ticket.css puts them in two columns on a wide screen. -#}
        <div class="ticket__columns">
            <div class="ticket__main">
                {#- Assist's component, embedded by name: Ticketing's UI may not use Assist's Api (deptrac). -#}
                {{ component('TheAsk', {ticket: ticket}) }}

                {#- Conversation's component, embedded by name: Ticketing's UI may not use Conversation's Api (deptrac). -#}
                {{ component('ThreadFrame', {key: ticket.key}) }}
            </div>

            {{ include('@Ticketing/_next_step.html.twig') }}

            {{ include('@Ticketing/_rounds.html.twig') }}

            <aside class="ticket__aside">
                {{ include('@Ticketing/_people.html.twig') }}
                {{ include('@Ticketing/_activity.html.twig') }}
                <section class="ticket__section" aria-labelledby="ticket-details-heading">
                    <h2 id="ticket-details-heading" class="ticket__section-title">Details</h2>
                    <dl class="ticket__details">
                        <div class="ticket__detail"><dt>Assignee</dt><dd>{{ assignee }}</dd></div>
                        <div class="ticket__detail"><dt>Priority</dt><dd>{{ priority }}</dd></div>
                        {% if ticket.release is not empty %}<div class="ticket__detail"><dt>Release</dt><dd>{{ ticket.release }}</dd></div>{% endif %}
                        {% if ticket.parentKey is not null %}<div class="ticket__detail"><dt>Parent</dt><dd class="ticket__key">{{ ticket.parentKey }}</dd></div>{% endif %}
                        {% if components is not empty %}<div class="ticket__detail"><dt>Components</dt><dd>{{ components }}</dd></div>{% endif %}
                        <div class="ticket__detail"><dt>Created</dt><dd>{{ created }}</dd></div>
                    </dl>
                </section>
            </aside>
        </div>
    </article>
{% endblock %}
