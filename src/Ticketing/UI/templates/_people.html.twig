{# The People section, from TicketPageParts: the page renders it, and a move's Turbo Stream answer replaces it. #}
<div id="{{ constant('App\\Ticketing\\UI\\TicketPageParts::PEOPLE_ID') }}" class="ticket__people" data-live-refresh>
    {% if people is not empty %}
        {# Notification's PingSheet, by name only, as Ticketing's UI may not use Notification (deptrac.yaml). #}
        {% set mayPing = is_granted('PING_SEND', ticket.visibilityFacts) %}
        {# Every row's PingSheet asks for all of them, so the ping window is read once for the whole list. #}
        {% set peopleUserIds = people|map(row => row.userId) %}
        <twig:People :people="people">
            <twig:block name="person_actions">
                {% if outerScope.mayPing %}
                    {{ component('PingSheet', {
                        ticketId: outerScope.ticket.id.toString,
                        ticketKey: outerScope.ticket.key,
                        ticketTitle: outerScope.ticket.title,
                        toUserId: person.userId,
                        toFirstName: person.firstName,
                        nowText: outerScope.turnLines is null ? null : outerScope.turnLines.now,
                        isViewer: person.isViewer,
                        peopleUserIds: outerScope.peopleUserIds,
                    }) }}
                {% endif %}
            </twig:block>
        </twig:People>
    {% endif %}
</div>
