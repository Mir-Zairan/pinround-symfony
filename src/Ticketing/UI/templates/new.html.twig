{% extends '@Web/base.html.twig' %}

{% block title %}New ticket · pinround{% endblock %}

{# The form fields and errors of the profile page, which this form shares; report.css gives Type and Priority the chips of Report a problem. #}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/profile.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/review.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/intake-check.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/report.css') }}">
{% endblock %}

{% block main %}
    <div class="profile">
        <h1 class="profile__title">New ticket</h1>
        {% if errors.form is defined %}
            <p class="login__error" role="alert">{{ errors.form }}</p>
        {% endif %}

        <twig:Card>
            {#- The person's own Type and Priority picks of a refused form, which the check's suggestions leave alone (markSuggestions in assets/intake_marks.js). -#}
            {%- set personPicked = input.personPickedFields %}
            <form class="login__form" method="post" action="{{ path('ticketing_ticket_new') }}"
                {%- if personPicked is not empty %} data-intake-check-person-picked="{{ personPicked|join(' ') }}"{% endif %}>
                <div class="profile__field">
                    <label class="form-field">
                        Project
                        <select class="form-field__input" name="project_id" required>
                            {% for project in projects %}
                                <option value="{{ project.id }}"{% if project.id == input.projectId %} selected{% endif %}>{{ project.key }} · {{ project.name }}</option>
                            {% endfor %}
                        </select>
                    </label>
                </div>
                <div class="profile__field">
                    <label class="form-field">
                        Title
                        <input class="form-field__input" type="text" name="title" value="{{ input.title }}" maxlength="{{ titleMaxLength }}" required
                            {%- if errors.title is defined %} aria-invalid="true" aria-describedby="ticket-title-error"{% endif %}>
                    </label>
                    {% if errors.title is defined %}
                        <p class="profile__error" id="ticket-title-error">{{ errors.title }}</p>
                    {% endif %}
                </div>
                <div class="profile__field">
                    <label class="form-field">
                        Description
                        <textarea class="form-field__input" name="description" rows="6" maxlength="{{ descriptionMaxLength }}"
                            {%- if errors.description is defined %} aria-invalid="true" aria-describedby="ticket-description-error"{% endif %}>{{ input.description }}</textarea>
                    </label>
                    {% if errors.description is defined %}
                        <p class="profile__error" id="ticket-description-error">{{ errors.description }}</p>
                    {% endif %}
                </div>
                {# The upload's target is the selected project's team; every team listed lets the reporter make tickets. #}
                {% set screenshotProject = projects|filter(project => project.id == input.projectId)|first|default(projects|first) %}
                {% if screenshotProject %}
                    <twig:ScreenshotReportField :uploadTargetKind="constant('App\\Ticketing\\UI\\Media\\NewTicketMediaTarget::KIND')" :uploadTargetId="screenshotProject.teamId.toString" :postedReport="report|default({})" :error="errors.screenshot|default(null)" />
                {% endif %}
                {# Assist's check by its component name, as Ticketing's UI may not use Assist (deptrac.yaml); inside the form, so its button posts the typed fields. #}
                <fieldset class="where-it-goes report__where">
                    <legend class="where-it-goes__title">Where it goes</legend>
                    {{ component('IntakeCheck') }}
                    <fieldset class="report__chips"{% if errors.type is defined %} aria-describedby="ticket-type-error"{% endif %}>
                        <legend class="report__label">Type</legend>
                        <div class="report__chip-row">
                            {% for value, typeLabel in typeLabels %}
                                <label class="chip report__chip">
                                    <input class="visually-hidden" type="radio" name="type" value="{{ value }}"{% if value == input.type %} checked{% endif %} required>
                                    {{ typeLabel }}
                                </label>
                            {% endfor %}
                        </div>
                        {% if errors.type is defined %}
                            <p class="profile__error" id="ticket-type-error">{{ errors.type }}</p>
                        {% endif %}
                    </fieldset>
                    <fieldset class="report__chips"{% if errors.priority is defined %} aria-describedby="ticket-priority-error"{% endif %}>
                        <legend class="report__label">Priority</legend>
                        <div class="report__chip-row">
                            {% for value, priorityLabel in priorityLabels %}
                                <label class="chip report__chip">
                                    <input class="visually-hidden" type="radio" name="priority" value="{{ value }}"{% if value == input.priority %} checked{% endif %} required>
                                    {{ priorityLabel }}
                                </label>
                            {% endfor %}
                        </div>
                        {% if errors.priority is defined %}
                            <p class="profile__error" id="ticket-priority-error">{{ errors.priority }}</p>
                        {% endif %}
                    </fieldset>
                </fieldset>
                {# Only a Lead may give a ticket to someone, so the people are those of the teams they lead. #}
                {% if mayAssign %}
                    <div class="profile__field">
                        <label class="form-field">
                            Give it to
                            <select class="form-field__input" name="assignee_id"
                                {%- if errors.assignee is defined %} aria-invalid="true" aria-describedby="ticket-assignee-error"{% endif %}>
                                <option value="">No one yet</option>
                                {% for group in assigneeGroups %}
                                    <optgroup label="{{ group.teamName }}">
                                        {% for assignee in group.assignees %}
                                            <option value="{{ assignee.id.toString }}"{% if assignee.id.toString == input.assigneeId %} selected{% endif %}>{{ assignee.displayName }}</option>
                                        {% endfor %}
                                    </optgroup>
                                {% endfor %}
                            </select>
                        </label>
                        {% if errors.assignee is defined %}
                            <p class="profile__error" id="ticket-assignee-error">{{ errors.assignee }}</p>
                        {% endif %}
                    </div>
                {% endif %}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token(csrfId) }}">
                <div class="report__buttons">
                    <twig:Button variant="text" href="{{ path('web_home') }}">Cancel</twig:Button>
                    <twig:Button type="submit">Create ticket</twig:Button>
                </div>
            </form>
        </twig:Card>
    </div>
{% endblock %}
