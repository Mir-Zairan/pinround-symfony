{% set moveController = 'App\\Ticketing\\UI\\TicketMoveController' %}
{% set csrfField = constant(moveController ~ '::CSRF_FIELD') %}
{% set versionField = constant(moveController ~ '::VERSION_FIELD') %}
{% set csrfToken = csrf_token(this.csrfTokenId) %}
<section{{ attributes.defaults({class: 'next-step-box', 'aria-labelledby': 'next-step-box-label'}) }}>
    <h2 class="next-step-box__label" id="next-step-box-label"{% if isHeadingAutofocused %} tabindex="-1" autofocus{% endif %}>Your next step</h2>
    <p class="next-step-box__sentence">{{ nextStep.sentence }}</p>
    {% set moveTransitions = this.moveTransitions %}
    {% if moveTransitions is not empty %}
        <div class="next-step-box__verbs">
            {% for transition in moveTransitions %}
                <form method="post" action="{{ path(constant(moveController ~ '::MOVE_ROUTE'), {key: ticketKey, verb: transition.verb}) }}" data-turbo="true">
                    <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">
                    <input type="hidden" name="{{ versionField }}" value="{{ version }}">
                    <twig:Button type="submit" variant="{{ transition.isPrimary ? 'filled' : 'outline' }}">{{ transition.label }}</twig:Button>
                </form>
            {% endfor %}
        </div>
    {% endif %}
    {% if nextStep.ruleNote is not null %}
        <p class="next-step-box__rule-note">{{ nextStep.ruleNote }}</p>
    {% endif %}
    {% if nextStep.groups is not empty %}
        {# A native disclosure: it opens without JavaScript, and the browser tells screen readers whether it is expanded. #}
        <details class="next-step-box__move-to"{% if isMoveListOpen %} open{% endif %}>
            <summary class="btn btn-text btn-sm">Move to another step…</summary>
            {% for group in nextStep.groups %}
                <div class="next-step-box__group" role="group" aria-labelledby="next-step-box-group-{{ group.groupCode }}">
                    <span class="next-step-box__group-label" id="next-step-box-group-{{ group.groupCode }}">{{ group.groupLabel }}</span>
                    <div class="next-step-box__chips">
                        {% for choice in group.choices %}
                            {% set moveToPath = path(constant(moveController ~ '::MOVE_TO_ROUTE'), {key: ticketKey, stepId: choice.step.id}) %}
                            {% if this.asksWhoItWaitsOn(choice) %}
                                {% set dialogId = 'needs-input-' ~ choice.step.id %}
                                {% set stepName = choice.step.name %}
                                {% set peopleToWaitOn = nextStep.peopleToWaitOn %}
                                {# Without script the chip posts its own form with empty waiting-on fields, so the ticket waits on its reporter. #}
                                <div class="waiting-on" {{ stimulus_controller('waiting-on') }}>
                                    <twig:Dialog id="{{ dialogId }}" title="Move to {{ stepName }}">
                                        <twig:block name="trigger">
                                            <form method="post" action="{{ moveToPath }}" data-turbo="true" {{ stimulus_target('waiting-on', 'moveForm') }}>
                                                <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">
                                                <input type="hidden" name="{{ versionField }}" value="{{ version }}">
                                                <input type="hidden" name="{{ constant(moveController ~ '::WAITING_ON_USER_FIELD') }}" value="" {{ stimulus_target('waiting-on', 'userField') }}>
                                                <input type="hidden" name="{{ constant(moveController ~ '::WAITING_ON_LABEL_FIELD') }}" value="" {{ stimulus_target('waiting-on', 'labelField') }}>
                                                <twig:Chip type="submit" aria-haspopup="dialog" data-action="dialog#open:prevent">{{ stepName }}</twig:Chip>
                                            </form>
                                        </twig:block>
                                        <twig:block name="content">
                                            <form method="dialog" id="{{ dialogId }}-form" class="waiting-on__form" data-action="change->waiting-on#chooseWhoItWaitsOn submit->waiting-on#move">
                                                <fieldset class="waiting-on__choices">
                                                    <legend class="waiting-on__legend">Who does it wait on?</legend>
                                                    {% for person in peopleToWaitOn %}
                                                        <label class="waiting-on__choice">
                                                            <input type="radio" name="waiting-on" value="{{ person.userId }}"{% if loop.first %} checked{% endif %} {{ stimulus_target('waiting-on', 'choice') }}>
                                                            {{ person.firstName }} · {{ person.roleNames }}
                                                        </label>
                                                    {% endfor %}
                                                    <label class="waiting-on__choice">
                                                        <input type="radio" name="waiting-on" value=""{% if peopleToWaitOn is empty %} checked{% endif %} {{ stimulus_target('waiting-on', 'choice someoneElse') }}>
                                                        Someone else
                                                    </label>
                                                    <input class="waiting-on__label" type="text" maxlength="{{ constant(moveController ~ '::WAITING_ON_LABEL_MAX_LENGTH') }}" required pattern=".*\S.*"
                                                        autocomplete="off" aria-label="Who else it waits on" placeholder="For example, Customer" title="Write a name or a role."
                                                        {%- if peopleToWaitOn is not empty %} disabled{% endif %} {{ stimulus_target('waiting-on', 'label') }}>
                                                </fieldset>
                                            </form>
                                        </twig:block>
                                        <twig:block name="actions">
                                            <twig:Button variant="text" data-action="dialog#close">Cancel</twig:Button>
                                            <twig:Button type="submit" form="{{ dialogId }}-form">Move</twig:Button>
                                        </twig:block>
                                    </twig:Dialog>
                                </div>
                            {% else %}
                                <form method="post" action="{{ moveToPath }}" data-turbo="true">
                                    <input type="hidden" name="{{ csrfField }}" value="{{ csrfToken }}">
                                    <input type="hidden" name="{{ versionField }}" value="{{ version }}">
                                    {% if choice.isCurrent %}
                                        <twig:Chip type="submit" :pressed="true" disabled aria-current="step">{{ choice.step.name }}</twig:Chip>
                                    {% else %}
                                        <twig:Chip type="submit">{{ choice.step.name }}</twig:Chip>
                                    {% endif %}
                                </form>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </details>
    {% endif %}
</section>
